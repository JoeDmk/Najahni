<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.EditThreadController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-color: #f4f6f8;">

    <center>
        <VBox alignment="CENTER">

            <!-- CARD -->
            <VBox spacing="20"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: white;
                         -fx-padding: 40;
                         -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 6);">

                <Label text="Edit Thread"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #111827;" />

                <TextField fx:id="titleField"
                           promptText="Thread Title"
                           prefWidth="400"
                           style="-fx-background-radius: 10;" />

                <TextArea fx:id="contentField"
                          promptText="Thread Content"
                          prefWidth="400"
                          prefHeight="180"
                          wrapText="true"
                          style="-fx-background-radius: 10;" />

                <HBox spacing="15">

                    <Button text="Cancel"
                            onAction="#goBack"
                            style="-fx-background-color: #9ca3af;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 10;" />

                    <Button text="💾 Save Changes"
                            onAction="#updateThread"
                            style="-fx-background-color: #4f46e5;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10;" />
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
