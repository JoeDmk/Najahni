<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.EventDetailsController"
            stylesheets="@styles/app.css">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="header">

            <Label fx:id="titleLabel"
                   styleClass="header-title"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="← Back"
                    onAction="#goBack"
                    styleClass="btn-secondary"/>

            <Button fx:id="validateTicketBtn"
                    text="Validate Ticket"
                    onAction="#onValidateTicket"
                    visible="false"
                    managed="false"
                    styleClass="btn-primary"/>
        </HBox>
    </top>

    <!-- BODY (WHOLE PAGE SCROLLABLE) -->
    <center>
        <VBox styleClass="content-area" fillWidth="true">

            <HBox spacing="30" styleClass="page-wrap" VBox.vgrow="ALWAYS">

                <!-- LEFT SIDE -->
                <VBox spacing="15" HBox.hgrow="ALWAYS" minWidth="600">

                    <VBox styleClass="card" spacing="10">
                        <Label text="Description" styleClass="card-title"/>
                        <Label fx:id="descriptionLabel" wrapText="true"/>
                    </VBox>

                    <VBox spacing="8" styleClass="ai-box">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="AI for this event" styleClass="section-title-sm"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Summary" onAction="#generateEventSummary" styleClass="btn-primary"/>
                            <Button text="Promo" onAction="#generateEventPromo" styleClass="btn-secondary"/>
                            <Button text="Checklist" onAction="#generateEventChecklist" styleClass="btn-secondary"/>
                        </HBox>

                        <TextArea fx:id="eventAiOutputLabel"
                                  editable="false"
                                  wrapText="true"
                                  focusTraversable="false"
                                  prefRowCount="4"
                                  styleClass="readonly-wrap"
                                  text="(Click a button to generate AI text)"/>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <Label fx:id="dateLabel" styleClass="muted-text"/>
                        <Label fx:id="weatherLabel" styleClass="muted-text" text="Weather: ..."/>
                        <Label fx:id="capacityLabel" styleClass="card-title"/>
                        <Button fx:id="joinBtn" styleClass="btn-primary"/>
                    </VBox>

                </VBox>

                <!-- RIGHT SIDE (fixed) -->
                <VBox spacing="15" prefWidth="320" minWidth="320" maxWidth="320">

                    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                        <Label text="Participants" styleClass="card-title"/>

                        <!-- make participants list scroll INSIDE only if too long? (optional) -->
                        <VBox fx:id="participantsContainer" spacing="10"/>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
