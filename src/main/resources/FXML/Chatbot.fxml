<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ChatbotController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="nav-bar">
             <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="NAJAHNI" />
             <HBox alignment="CENTER_RIGHT" spacing="20" HBox.hgrow="ALWAYS">
                 <Button fx:id="btnRequests" styleClass="nav-button" text="Requests" />
                 <Button fx:id="btnSessions" styleClass="nav-button" text="Sessions" />
                 <Button fx:id="btnAvailability" styleClass="nav-button" text="Availability" />
                 <Button styleClass="nav-button, active" text="Chatbot" />
             </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Chatbot Assistant" />
            </HBox>

            <TextArea fx:id="chatArea" editable="false" prefHeight="400.0" prefWidth="600.0" styleClass="chat-area" wrapText="true" VBox.vgrow="ALWAYS" />

             <HBox alignment="CENTER_LEFT" spacing="10">
                 <TextField fx:id="inputField" prefWidth="500.0" promptText="Type your message here..." styleClass="chat-input" HBox.hgrow="ALWAYS" />
                 <Button fx:id="btnSend" styleClass="button" text="Send" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
