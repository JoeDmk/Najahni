<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MentorshipRequestListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="nav-bar">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="NAJAHNI" />
            <HBox alignment="CENTER_RIGHT" spacing="20" HBox.hgrow="ALWAYS">
                <Button styleClass="nav-button, active" text="Requests" />
                <Button fx:id="btnSessions" styleClass="nav-button" text="Sessions" />
                <Button fx:id="btnAvailability" styleClass="nav-button" text="Availability" />
                <Button fx:id="btnChatbot" styleClass="nav-button" text="Chatbot" />
             </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Mentorship Requests" />
                <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                    <TextField fx:id="searchField" promptText="Search request..." />
                    <Button fx:id="btnSort" styleClass="button-secondary" text="Status: All" />
                    <Button fx:id="btnAdd" styleClass="button" text="+ New Request" />
                </HBox>
            </HBox>

            <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="cards-scroll-pane" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" style="-fx-padding: 10;" />
            </ScrollPane>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnDelete" styleClass="button-secondary" text="Delete" />
                <Button fx:id="btnEdit" styleClass="button-secondary" text="Edit" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
