<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MentorAvailabilityListController" stylesheets="@../assets/css/style.css">
    <top>
        <HBox spacing="10" styleClass="nav-bar" alignment="CENTER_LEFT">
             <Label text="NAJAHNI" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
             <HBox spacing="20" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                 <Button text="Requests" styleClass="nav-button" fx:id="btnRequests"/>
                 <Button text="Sessions" styleClass="nav-button" fx:id="btnSessions"/>
                 <Button text="Availability" styleClass="nav-button, active"/>
             </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Mentor Availability" styleClass="header-label"/>
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                    <Button text="+ New Availability" styleClass="button" fx:id="btnAdd"/>
                </HBox>
            </HBox>

            <TableView fx:id="tableView" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                     <TableColumn text="ID" prefWidth="50"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
                     <TableColumn text="Mentor" prefWidth="150"><cellValueFactory><PropertyValueFactory property="mentorName"/></cellValueFactory></TableColumn>
                     <TableColumn text="Date" prefWidth="100"><cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory></TableColumn>
                     <TableColumn text="Start Time" prefWidth="100"><cellValueFactory><PropertyValueFactory property="startTime"/></cellValueFactory></TableColumn>
                     <TableColumn text="End Time" prefWidth="100"><cellValueFactory><PropertyValueFactory property="endTime"/></cellValueFactory></TableColumn>
                     <TableColumn text="Created At" prefWidth="150"><cellValueFactory><PropertyValueFactory property="createdAt"/></cellValueFactory></TableColumn>
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

             <HBox spacing="10" alignment="CENTER_RIGHT">
                 <Button text="Delete" styleClass="button-secondary" fx:id="btnDelete"/>
                 <Button text="Edit" styleClass="button-secondary" fx:id="btnEdit"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
