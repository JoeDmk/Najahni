<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MentorshipSessionListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="nav-bar">
             <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="NAJAHNI" />
             <HBox alignment="CENTER_RIGHT" spacing="20" HBox.hgrow="ALWAYS">
                 <Button fx:id="btnRequests" styleClass="nav-button" text="Requests" />
                 <Button styleClass="nav-button, active" text="Sessions" />
                 <Button fx:id="btnAvailability" styleClass="nav-button" text="Availability" />
                 <Button fx:id="btnChatbot" styleClass="nav-button" text="Chatbot" />
             </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Mentorship Sessions" />
                <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                    <DatePicker fx:id="searchDate" promptText="Search by date..." />
                    <Button fx:id="btnExportPDF" styleClass="button" text="Export PDF" />
                    <Button fx:id="btnExportExcel" styleClass="button" text="Export Excel" />
                    <Button fx:id="btnAdd" styleClass="button" text="+ New Session" />
                </HBox>
            </HBox>

            <TableView fx:id="tableView" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                     <TableColumn prefWidth="50" text="ID"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="100" text="Request ID"><cellValueFactory><PropertyValueFactory property="requestId" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Scheduled At"><cellValueFactory><PropertyValueFactory property="scheduledAt" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="80" text="Duration"><cellValueFactory><PropertyValueFactory property="durationMinutes" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="100" text="Status"><cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="200" text="Meeting Link"><cellValueFactory><PropertyValueFactory property="meetingLink" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Mentor Feedback"><cellValueFactory><PropertyValueFactory property="mentorFeedback" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Entr. Feedback"><cellValueFactory><PropertyValueFactory property="entrepreneurFeedback" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="80" text="Men. Rating"><cellValueFactory><PropertyValueFactory property="mentorRating" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="80" text="Entr. Rating"><cellValueFactory><PropertyValueFactory property="entrepreneurRating" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Created At"><cellValueFactory><PropertyValueFactory property="createdAt" /></cellValueFactory></TableColumn>
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

             <HBox alignment="CENTER_RIGHT" spacing="10">
                 <Button fx:id="btnDelete" styleClass="button-secondary" text="Delete" />
                 <Button fx:id="btnEdit" styleClass="button-secondary" text="Edit" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
