# ====================================================
# Secrets configuration template
# Copy this file to secrets.properties and fill in your values
# ====================================================

# Twilio SMS
twilio.account_sid=YOUR_TWILIO_ACCOUNT_SID
twilio.auth_token=YOUR_TWILIO_AUTH_TOKEN
twilio.phone_number=+1XXXXXXXXXX

# Google OAuth 2.0
google.client_id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
google.client_secret=YOUR_GOOGLE_CLIENT_SECRET
