# ====================================================
# Secrets configuration template
# Copy this file to secrets.properties and fill in your values
# ====================================================

# Twilio SMS
twilio.account_sid=YOUR_TWILIO_ACCOUNT_SID
twilio.auth_token=YOUR_TWILIO_AUTH_TOKEN
twilio.phone_number=+1XXXXXXXXXX

# Google OAuth 2.0
google.client_id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
google.client_secret=YOUR_GOOGLE_CLIENT_SECRET

# GROQ AI (Community module - threads, events, replies)
groq.api_key=YOUR_GROQ_API_KEY

# Stripe (Investment module - payments)
stripe.secret_key=YOUR_STRIPE_SECRET_KEY

# HuggingFace (Investment module - AI chat primary)
hf.token=YOUR_HF_TOKEN
hf.model=meta-llama/Llama-3.2-3B-Instruct

# Gemini (Investment module - AI chat fallback)
gemini.api_key=YOUR_GEMINI_API_KEY

# NewsAPI (Projets module - sector news)
newsapi.api_key=YOUR_NEWSAPI_KEY

# Gmail SMTP (Projets module - email notifications)
email.sender=YOUR_GMAIL@gmail.com
email.app_password=YOUR_GMAIL_APP_PASSWORD
