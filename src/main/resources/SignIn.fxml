<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.najahni.controllers.SignInController"
            styleClass="login-background"
            stylesheets="/css/najahni.css"
            prefWidth="900" prefHeight="600">

    <!-- Left Side - Branding -->
    <left>
        <VBox styleClass="login-branding" spacing="20" alignment="CENTER" minWidth="400" maxWidth="400">
            <padding>
                <Insets top="50" right="40" bottom="50" left="40"/>
            </padding>



            <Label text="NAJAHNI" styleClass="login-brand-title"/>

            <Label text="Plateforme d'Entrepreneuriat&#10;et d'Investissement"
                   styleClass="login-brand-subtitle" textAlignment="CENTER" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS" minHeight="30"/>

            <VBox spacing="15" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-size: 18px;"/>
                    <Label text="Gérez vos projets entrepreneuriaux" style="-fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-size: 18px;"/>
                    <Label text="Trouvez des investisseurs" style="-fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-size: 18px;"/>
                    <Label text="Apprenez et développez vos compétences" style="-fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-size: 18px;"/>
                    <Label text="Gagnez des badges et montez en niveau" style="-fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="© 2026 NAJAHNI - PIDEV Project"
                   style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <!-- Right Side - Login Form -->
    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #f5f6fa;">
            <VBox fx:id="loginContainer" styleClass="login-form-container" spacing="25"
                  alignment="CENTER" maxWidth="380">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="Connexion" styleClass="login-title"/>
                <Label text="Bienvenue ! Connectez-vous à votre compte."
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>

                <VBox spacing="8">
                    <Label text="Adresse Email" styleClass="form-label"/>
                    <TextField fx:id="txtEmail" promptText="exemple@najahni.tn"
                               styleClass="login-field" prefHeight="45"/>
                </VBox>

                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Mot de Passe" styleClass="form-label"/>
                        <Region HBox.hgrow="ALWAYS"/>

                    </HBox>
                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                   styleClass="login-field" prefHeight="45"/>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkRemember" text="Se souvenir de moi"
                              style="-fx-text-fill: #7f8c8d;"/>
                </HBox>

                <Label fx:id="lblError" text="" wrapText="true"
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" maxWidth="300"/>

                <Button fx:id="btnLogin" text="Se Connecter" onAction="#handleLogin"
                        styleClass="btn-login" prefHeight="50" maxWidth="Infinity"/>

                <Separator/>

                <VBox spacing="10" alignment="CENTER">
                    <Label text="Accès rapide pour test:"
                           style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>

                    <Button text="Compte Démo"
                            styleClass="btn-demo"
                            prefHeight="35"
                            maxWidth="Infinity"/>
                </VBox>


                <Separator/>

                <HBox spacing="5" alignment="CENTER">
                    <Label text="Pas encore inscrit ?" style="-fx-text-fill: #7f8c8d;"/>

                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>