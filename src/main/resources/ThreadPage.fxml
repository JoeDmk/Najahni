<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ThreadPageController"
            prefWidth="900"
            prefHeight="650"
            stylesheets="@styles/app.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <Label text="Thread" styleClass="header-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area">

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">
                <VBox spacing="18" styleClass="page-wrap">

                    <!-- THREAD CARD -->
                    <VBox spacing="12" styleClass="card">
                        <Label fx:id="threadTitle" styleClass="card-title"/>

                        <Label fx:id="threadContent"
                               wrapText="true"/>

                        <!-- AI SUMMARY -->
                        <VBox spacing="8" styleClass="ai-box">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="AI Summary" styleClass="section-title-sm"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Generate"
                                        onAction="#generateSummary"
                                        styleClass="btn-primary"/>
                            </HBox>

                            <Label fx:id="summaryLabel"
                                   text="(Click Generate to summarize this discussion)"
                                   wrapText="true"
                                   styleClass="muted-text"/>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="editButton"
                                    text="Edit"
                                    onAction="#editThread"
                                    styleClass="btn-primary"/>

                            <Button fx:id="deleteButton"
                                    text="Delete"
                                    onAction="#deleteThread"
                                    styleClass="btn-danger"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="commentCountLabel" styleClass="muted-text"/>
                        </HBox>
                    </VBox>

                    <!-- COMMENTS LIST -->
                    <VBox fx:id="commentsContainer" spacing="12"/>

                    <!-- ADD COMMENT -->
                    <VBox spacing="10" styleClass="card">
                        <Label text="Add a comment" styleClass="section-title-sm"/>

                        <TextArea fx:id="commentField"
                                  promptText="Write a comment..."
                                  prefRowCount="3"
                                  wrapText="true"
                                  styleClass="form-field"/>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Add Comment"
                                    onAction="#addComment"
                                    styleClass="btn-primary"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
