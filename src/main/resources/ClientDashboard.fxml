<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.najahni.controllers.ClientDashboardController"
            styleClass="root"
            style="-fx-background-color: #ecf0f1;">

    <!-- ========== HEADER ========== -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #2c3e50, #3498db);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);"
              spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 14 24 0 24;">

                <!-- Logo / Titre gauche -->
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="NAJAHNI"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Plateforme d'évaluation de projets"
                           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                </VBox>

                <!-- Bouton déconnecter droite -->
                <Button text="← Déconnecter"
                        onAction="#retourAccueil"
                        styleClass="btn-retour"
                        prefWidth="170"
                        prefHeight="38"/>
            </HBox>

            <!-- Sous-barre titre centré -->
            <HBox alignment="CENTER" style="-fx-padding: 10 24 18 24;">
                <VBox alignment="CENTER" spacing="3">
                    <Label text="Espace Client — Mes Projets"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.9);"/>
                    <Label text="Gérez, soumettez et suivez vos projets entrepreneuriaux"
                           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.55);"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <VBox spacing="18" style="-fx-padding: 24; -fx-background-color: #ecf0f1;">

            <!-- ===== BARRE D'ACTIONS ===== -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-padding: 16 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);
                         -fx-border-color: #f0f0f0; -fx-border-width: 1; -fx-border-radius: 12;">

                <Label text="📋" style="-fx-font-size: 20px;"/>
                <Label text="Mes Projets"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="➕  Nouveau Projet"
                        onAction="#ouvrirAjout"
                        styleClass="btn-primary"
                        prefHeight="38"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-padding: 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.35), 6, 0, 0, 2);"/>

                <Button text="🔄  Rafraîchir"
                        onAction="#rafraichir"
                        prefHeight="38"
                        style="-fx-background-color: #ecf0f1; -fx-text-fill: #34495e;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-padding: 0 18; -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: #d0d3d4; -fx-border-width: 1; -fx-border-radius: 8;"/>
            </HBox>

            <!-- ===== BARRE DE RECHERCHE ET TRI ===== -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-padding: 14 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                         -fx-border-color: #f0f0f0; -fx-border-width: 1; -fx-border-radius: 12;">

                <!-- Search -->
                <Label text="🔍"
                       style="-fx-font-size: 16px; -fx-text-fill: #95a5a6;"/>
                <TextField fx:id="champRecherche"
                           promptText="Rechercher par titre, secteur"
                           prefWidth="340" prefHeight="36"
                           style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;
                                  -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1.5;
                                  -fx-font-size: 13px; -fx-padding: 0 12;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Sort -->
                <Label text="Trier par :"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                <ComboBox fx:id="comboTri"
                          prefWidth="230" prefHeight="36"
                          style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;
                                 -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-border-width: 1.5;
                                 -fx-font-size: 13px;"/>
            </HBox>

            <!-- ===== TABLEAU DES PROJETS ===== -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 14, 0, 0, 4);
                         -fx-border-color: #f0f0f0; -fx-border-width: 1; -fx-border-radius: 12;"
                  VBox.vgrow="ALWAYS">

                <TableView fx:id="projetsTable"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="155"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="210"/>
                        <TableColumn fx:id="colSecteur" text="Secteur" prefWidth="115"/>
                        <TableColumn fx:id="colEtape" text="Étape" prefWidth="115"/>
                        <TableColumn fx:id="colDate" text="Date création" prefWidth="125"/>
                        <TableColumn fx:id="colCouts" text="Coûts (DT)" prefWidth="110"/>
                        <TableColumn fx:id="colRevenus" text="Revenus (DT)" prefWidth="115"/>
                        <TableColumn fx:id="actions" text="Actions" prefWidth="500" sortable="false"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                            <Label text="📂"
                                   style="-fx-font-size: 48px; -fx-opacity: 0.3;"/>
                            <Label text="Aucun projet pour le moment"
                                   style="-fx-font-size: 15px; -fx-text-fill: #bdc3c7; -fx-font-style: italic;"/>
                            <Label text="Cliquez sur « Nouveau Projet » pour commencer"
                                   style="-fx-font-size: 12px; -fx-text-fill: #d5d8dc;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ===== FOOTER BAR ===== -->
            <HBox alignment="CENTER_RIGHT" spacing="10"
                  style="-fx-padding: 0 4;">
                <Label text="💡 Astuce : Soumettez votre projet pour obtenir une évaluation IA instantanée"
                       style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-style: italic;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
