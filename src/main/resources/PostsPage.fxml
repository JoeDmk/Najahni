<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.PostsPageController"
            prefWidth="900"
            prefHeight="650"
            stylesheets="@styles/app.css">

    <!-- HEADER -->
    <top>
        <VBox spacing="12" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Posts" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="← Back"
                        onAction="#goBack"
                        styleClass="btn-secondary"/>

                <Button text="+ New Post"
                        onAction="#focusComposer"
                        styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">

            <VBox styleClass="content-area" spacing="15">

                <!-- Composer Card -->
                <VBox styleClass="card" spacing="10">
                    <Label text="Share something…" styleClass="section-title-sm"/>

                    <TextArea fx:id="contentArea"
                              promptText="What’s on your mind?"
                              wrapText="true"
                              prefRowCount="3"
                              styleClass="form-field"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="📷 Add Image"
                                onAction="#handlePickImage"
                                styleClass="btn-secondary"/>

                        <Label fx:id="imageStatusLabel"
                               text=""
                               styleClass="muted-text"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Post"
                                onAction="#handleCreatePost"
                                styleClass="btn-primary"/>
                    </HBox>
                </VBox>

                <!-- Feed Controls -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-bar">
                    <ComboBox fx:id="sortComboBox"
                              prefWidth="180"
                              promptText="Sort by"
                              onAction="#handleSortChange"/>

                    <TextField fx:id="searchField"
                               promptText="Search posts..."
                               prefWidth="280"
                               onKeyReleased="#handleSearch"
                               styleClass="form-field"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Refresh"
                            onAction="#handleRefresh"
                            styleClass="btn-secondary"/>
                </HBox>

                <!-- Posts Container -->
                <VBox fx:id="postsContainer"
                      spacing="18"
                      styleClass="page-wrap"/>

            </VBox>

        </ScrollPane>
    </center>


</BorderPane>
