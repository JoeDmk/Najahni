<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.najahni.controllers.InvestmentController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="15" style="-fx-background-color: transparent;">
    
    <padding>
        <Insets top="10" right="15" bottom="10" left="10"/>
    </padding>
    
    <!-- En-tête de Page -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Opportunités d'Investissement" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouvel Investissement" onAction="#showAddForm" styleClass="btn-primary"/>
        <Button text="🔄 Actualiser" onAction="#refreshTable" styleClass="btn-secondary"/>
    </HBox>
    
    <Separator/>
    
    <!-- Cartes de Résumé -->
    <HBox spacing="15">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblPendingCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
            <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblAcceptedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Acceptés" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblCompletedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
            <Label text="Terminés" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblTotalAmount" text="0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
            <Label text="Total Investi" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
    </HBox>
    
    <!-- Contenu Principal - Vue Divisée -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" minHeight="450">
        
        <!-- Tableau des Investissements -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Liste des Investissements" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <!-- Barre de Recherche/Filtre -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cboStatusFilter" promptText="Filtrer par statut" prefWidth="150"/>
                <ComboBox fx:id="cboProjectFilter" promptText="Filtrer par projet" prefWidth="200"/>
                <Button text="Filtrer" onAction="#filterInvestments" styleClass="btn-primary"/>
                <Button text="Effacer" onAction="#clearFilter" styleClass="btn-secondary"/>
            </HBox>
            
            <TableView fx:id="investmentsTable" VBox.vgrow="ALWAYS" minHeight="380">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" minWidth="50"/>
                    <TableColumn fx:id="colAmount" text="Montant" prefWidth="140" minWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colProject" text="Projet" prefWidth="230" minWidth="200"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="150" minWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Aucun investissement trouvé"/>
                </placeholder>
            </TableView>
        </VBox>
        
        <!-- Formulaire Investissement -->
        <VBox fx:id="formContainer" styleClass="form-container" spacing="15" minWidth="360" maxWidth="360">
            <Label fx:id="formTitle" text="Ajouter un Investissement" styleClass="form-title"/>
            
            <Separator/>
            
            <!-- Champ ID Masqué -->
            <TextField fx:id="txtId" visible="false" managed="false"/>
            
            <!-- Sélection du Projet -->
            <VBox spacing="5">
                <Label text="Projet *" styleClass="form-label"/>
                <ComboBox fx:id="cboProject" promptText="Sélectionnez un projet" maxWidth="Infinity" styleClass="form-field"/>
            </VBox>
            
            <!-- Champ Montant -->
            <VBox spacing="5">
                <Label text="Montant de l'Investissement (€) *" styleClass="form-label"/>
                <TextField fx:id="txtAmount" promptText="Entrez le montant (ex: 50000.00)" styleClass="form-field"/>
            </VBox>
            
            <!-- Sélection du Statut -->
            <VBox spacing="5">
                <Label text="Statut *" styleClass="form-label"/>
                <ComboBox fx:id="cboStatus" promptText="Sélectionnez un statut" maxWidth="Infinity" styleClass="form-field"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Boutons du Formulaire -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnSave" text="💾 Enregistrer" onAction="#saveInvestment" styleClass="btn-success"/>
                <Button fx:id="btnCancel" text="❌ Annuler" onAction="#cancelForm" styleClass="btn-secondary"/>
            </HBox>
            
            <Label fx:id="lblFormMessage" text="" styleClass="form-message"/>
        </VBox>
        
    </HBox>
    
</VBox>
</content>
</ScrollPane>
