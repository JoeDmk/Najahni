<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.InvestmentOpportunityController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="15" style="-fx-background-color: transparent;">

    <padding>
        <Insets top="10" right="15" bottom="10" left="10"/>
    </padding>

    <!-- En-tête de Page -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Opportunités d'Investissement" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouvelle Opportunité" onAction="#showAddForm" styleClass="btn-primary"/>
        <Button text="🔄 Actualiser" onAction="#refreshTable" styleClass="btn-secondary"/>
    </HBox>

    <Separator/>

    <!-- Cartes de Résumé -->
    <HBox spacing="15">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblOpenCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Ouvertes" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblClosedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            <Label text="Fermées" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblFundedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
            <Label text="Financées" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblTotalAmount" text="0.00 €" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
            <Label text="Montant Total Cible" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
    </HBox>

    <!-- Contenu Principal -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" minHeight="450">

        <!-- Tableau des Opportunités -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Liste des Opportunités" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <!-- Barre de Filtre -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cboStatusFilter" promptText="Filtrer par statut" prefWidth="150"/>
                <ComboBox fx:id="cboProjectFilter" promptText="Filtrer par projet" prefWidth="200"/>
                <Button text="Filtrer" onAction="#filterOpportunities" styleClass="btn-primary"/>
                <Button text="Effacer" onAction="#clearFilter" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="opportunitiesTable" VBox.vgrow="ALWAYS" minHeight="380">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="45"/>
                    <TableColumn fx:id="colTargetAmount" text="Montant Cible" prefWidth="130" minWidth="110"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="180" minWidth="150"/>
                    <TableColumn fx:id="colDeadline" text="Deadline" prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colProject" text="Projet" prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="colRiskScore" text="🎯 Risque IA" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colRiskLabel" text="🤖 ML" prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="200" minWidth="180"/>
                </columns>
                <placeholder>
                    <Label text="Aucune opportunité trouvée"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Formulaire Opportunité (dans un ScrollPane pour accéder aux boutons) -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    minWidth="380" maxWidth="380"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
          <content>
            <VBox fx:id="formContainer" styleClass="form-container" spacing="15">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label fx:id="formTitle" text="Ajouter une Opportunité" styleClass="form-title"/>

                <Separator/>

                <!-- Champ ID Masqué -->
                <TextField fx:id="txtId" visible="false" managed="false"/>

                <!-- Sélection du Projet -->
                <VBox spacing="5">
                    <Label text="Projet *" styleClass="form-label"/>
                    <ComboBox fx:id="cboProject" promptText="Sélectionnez un projet" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Montant Cible -->
                <VBox spacing="5">
                    <Label text="Montant Cible (€) *" styleClass="form-label"/>
                    <TextField fx:id="txtTargetAmount" promptText="Ex: 100000.00" styleClass="form-field"/>
                </VBox>

                <!-- Description -->
                <VBox spacing="5">
                    <Label text="Description" styleClass="form-label"/>
                    <TextField fx:id="txtDescription" promptText="Description de l'opportunité" styleClass="form-field"/>
                </VBox>

                <!-- Deadline -->
                <VBox spacing="5">
                    <Label text="Deadline" styleClass="form-label"/>
                    <DatePicker fx:id="dpDeadline" promptText="Date limite" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Statut -->
                <VBox spacing="5">
                    <Label text="Statut *" styleClass="form-label"/>
                    <ComboBox fx:id="cboStatus" promptText="Sélectionnez un statut" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Boutons du Formulaire -->
                <HBox spacing="10" alignment="CENTER">
                    <padding>
                        <Insets top="10"/>
                    </padding>
                    <Button text="💾 Enregistrer" onAction="#saveOpportunity" styleClass="btn-success"/>
                    <Button text="❌ Annuler" onAction="#cancelForm" styleClass="btn-secondary"/>
                </HBox>

                <Label fx:id="lblFormMessage" text="" styleClass="form-message"/>
            </VBox>
          </content>
        </ScrollPane>

    </HBox>

</VBox>
</content>
</ScrollPane>
