<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.InvestmentOfferController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="15" style="-fx-background-color: transparent;">

    <padding>
        <Insets top="10" right="15" bottom="10" left="10"/>
    </padding>

    <!-- En-tête de Page -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Offres d'Investissement" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouvelle Offre" onAction="#showAddForm" styleClass="btn-primary"/>
        <Button text="🔄 Actualiser" onAction="#refreshTable" styleClass="btn-secondary"/>
    </HBox>

    <Separator/>

    <!-- Cartes de Résumé -->
    <HBox spacing="15">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblPendingCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
            <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblAcceptedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Acceptées" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblRejectedCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            <Label text="Rejetées" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblTotalOffers" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
            <Label text="Total Offres" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
    </HBox>

    <!-- Contenu Principal -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" minHeight="450">

        <!-- Tableau des Offres -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Liste des Offres" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <!-- Barre de Filtre -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cboStatusFilter" promptText="Filtrer par statut" prefWidth="150"/>
                <ComboBox fx:id="cboOpportunityFilter" promptText="Filtrer par opportunité" prefWidth="250"/>
                <Button text="Filtrer" onAction="#filterOffers" styleClass="btn-primary"/>
                <Button text="Effacer" onAction="#clearFilter" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="offersTable" VBox.vgrow="ALWAYS" minHeight="380">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="45"/>
                    <TableColumn fx:id="colProposedAmount" text="Montant Proposé" prefWidth="140" minWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colInvestor" text="Investisseur" prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="colOpportunity" text="Opportunité" prefWidth="180" minWidth="150"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="180" minWidth="150"/>
                </columns>
                <placeholder>
                    <Label text="Aucune offre trouvée"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Formulaire Offre (dans un ScrollPane pour accéder aux boutons) -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    minWidth="380" maxWidth="380"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
          <content>
            <VBox fx:id="formContainer" styleClass="form-container" spacing="15">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label fx:id="formTitle" text="Nouvelle Offre d'Investissement" styleClass="form-title"/>

                <Separator/>

                <!-- Champ ID Masqué -->
                <TextField fx:id="txtId" visible="false" managed="false"/>

                <!-- Sélection de l'Investisseur -->
                <VBox spacing="5">
                    <Label text="Investisseur *" styleClass="form-label"/>
                    <ComboBox fx:id="cboInvestor" promptText="Sélectionnez un investisseur" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Sélection de l'Opportunité -->
                <VBox spacing="5">
                    <Label text="Opportunité *" styleClass="form-label"/>
                    <ComboBox fx:id="cboOpportunity" promptText="Sélectionnez une opportunité" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Montant Proposé -->
                <VBox spacing="5">
                    <Label text="Montant Proposé (€) *" styleClass="form-label"/>
                    <TextField fx:id="txtProposedAmount" promptText="Ex: 25000.00" styleClass="form-field"/>
                </VBox>

                <!-- Statut -->
                <VBox spacing="5">
                    <Label text="Statut *" styleClass="form-label"/>
                    <ComboBox fx:id="cboStatus" promptText="Sélectionnez un statut" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <!-- Boutons du Formulaire -->
                <HBox spacing="10" alignment="CENTER">
                    <padding>
                        <Insets top="10"/>
                    </padding>
                    <Button text="💾 Enregistrer" onAction="#saveOffer" styleClass="btn-success"/>
                    <Button text="❌ Annuler" onAction="#cancelForm" styleClass="btn-secondary"/>
                </HBox>

                <Label fx:id="lblFormMessage" text="" styleClass="form-message"/>
            </VBox>
          </content>
        </ScrollPane>

    </HBox>

</VBox>
</content>
</ScrollPane>
