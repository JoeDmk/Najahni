<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.FrontOpportunitiesController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="front-scroll"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="20" styleClass="front-page">
    <padding>
        <Insets top="15" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ═══ HERO SECTION ═══ -->
    <VBox styleClass="front-hero" alignment="CENTER" spacing="8">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>
        <Label text="💰 Opportunités d'Investissement" styleClass="front-hero-title"/>
        <Label fx:id="lblHeroSubtitle"
               text="Découvrez les projets qui recherchent un financement et investissez dès maintenant."
               styleClass="front-hero-subtitle" wrapText="true"/>
    </VBox>

    <!-- ═══ CREATE OPPORTUNITY FORM (Entrepreneur only, hidden by default) ═══ -->
    <TitledPane fx:id="newOppPane" text="➕  Créer une Opportunité d'Investissement" expanded="false"
                visible="false" managed="false" styleClass="front-form-pane">
        <VBox spacing="18" style="-fx-padding: 24 28 28 28;">

            <!-- Form header description -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #eaf2f8; -fx-background-radius: 12; -fx-padding: 14 18;">
                <Label text="💡" style="-fx-font-size: 22;"/>
                <VBox spacing="2">
                    <Label text="Publiez une opportunité pour attirer des investisseurs"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Renseignez les détails de votre demande de financement ci-dessous."
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>

            <!-- Row 1: Project + Amount -->
            <HBox spacing="18" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="🏢 Projet" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cboProject" promptText="Sélectionnez un projet..."
                              maxWidth="Infinity" prefHeight="40"
                              style="-fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10;"/>
                </VBox>
                <VBox spacing="6" prefWidth="220">
                    <Label text="💰 Montant cible (€)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtTargetAmount" promptText="Ex: 50 000" prefHeight="40"
                               style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-border-radius: 10;"/>
                </VBox>
            </HBox>

            <!-- Row 2: Description -->
            <VBox spacing="6">
                <Label text="📝 Description" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TextArea fx:id="txtOppDescription" promptText="Décrivez l'objectif de financement, l'utilisation des fonds, les étapes clés..."
                          prefRowCount="4" wrapText="true"
                          style="-fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10;"/>
            </VBox>

            <!-- Row 3: Deadline -->
            <HBox spacing="18" alignment="CENTER_LEFT">
                <VBox spacing="6">
                    <Label text="📅 Date limite" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <DatePicker fx:id="dpDeadline" prefHeight="40" prefWidth="220"
                                style="-fx-font-size: 13px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Error message -->
            <Label fx:id="lblOppFormMsg" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <!-- Action buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                <Button text="✖  Annuler" onAction="#clearOppForm" styleClass="front-btn-secondary"
                        style="-fx-padding: 10 22; -fx-font-size: 13px; -fx-background-radius: 10;"/>
                <Button text="✅  Créer l'Opportunité" onAction="#submitOpportunity" styleClass="front-btn-primary"
                        style="-fx-padding: 10 28; -fx-font-size: 13px; -fx-background-radius: 10;
                               -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.3), 8, 0, 0, 2);"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- ═══ STATS BAR ═══ -->
    <HBox spacing="15" alignment="CENTER">
        <VBox styleClass="front-stat" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTotalOpps" text="0" styleClass="front-stat-value"/>
            <Label text="Opportunités" styleClass="front-stat-label"/>
        </VBox>
        <VBox styleClass="front-stat" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblOpenOpps" text="0" styleClass="front-stat-value-green"/>
            <Label text="Ouvertes" styleClass="front-stat-label"/>
        </VBox>
        <VBox styleClass="front-stat" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTotalTarget" text="0 €" styleClass="front-stat-value-blue"/>
            <Label text="Montant Total" styleClass="front-stat-label"/>
        </VBox>
        <VBox styleClass="front-stat" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblFundedOpps" text="0" styleClass="front-stat-value-purple"/>
            <Label text="Financées" styleClass="front-stat-label"/>
        </VBox>
    </HBox>

    <!-- ═══ FILTER BAR ═══ -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="front-filter-bar">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <Label text="🔍" style="-fx-font-size: 16px;"/>
        <TextField fx:id="txtSearch" promptText="Rechercher par projet ou description..." 
                   HBox.hgrow="ALWAYS" styleClass="front-search-field"/>
        <ComboBox fx:id="cboStatusFilter" promptText="Statut" prefWidth="140" styleClass="front-combo"/>
        <Button text="Filtrer" onAction="#applyFilter" styleClass="front-btn-primary"/>
        <Button text="Effacer" onAction="#clearFilter" styleClass="front-btn-secondary"/>
    </HBox>

    <!-- ═══ OPPORTUNITIES GRID (Cards) ═══ -->
    <FlowPane fx:id="cardsContainer" hgap="18" vgap="18" alignment="CENTER" 
              VBox.vgrow="ALWAYS" prefWrapLength="900"/>

    <!-- ═══ EMPTY STATE ═══ -->
    <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false"
          style="-fx-padding: 50;">
        <Label text="📭" style="-fx-font-size: 48px;"/>
        <Label text="Aucune opportunité disponible" style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
        <Label text="Revenez plus tard ou modifiez vos filtres." style="-fx-font-size: 13px; -fx-text-fill: #95a5a6;"/>
    </VBox>

</VBox>
</content>
</ScrollPane>
