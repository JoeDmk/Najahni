<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="advancedRoot"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.najahni.controllers.AdvancedInvestmentController"
           styleClass="fo-content">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                styleClass="fo-scroll-pane"
                style="-fx-background-color: transparent;">
        <VBox spacing="0" alignment="TOP_CENTER" style="-fx-background-color: transparent;">

            <!-- ═══ PAGE HEADER ═══ -->
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: linear-gradient(to right, #2c3e50, #34495e); -fx-padding: 28 40 22 40;">
                <Label fx:id="lblPageTitle" text="🧾 Contrats Numériques"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="lblPageSubtitle" text="Signez et vérifiez vos contrats d'investissement"
                       style="-fx-font-size: 12; -fx-text-fill: #bdc3c7;"/>
            </VBox>

            <!-- ═══ TAB BAR ═══ -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: #f8f9fa; -fx-padding: 10 20; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
                <Button fx:id="btnContracts" text="🧾 Contrats"
                        onAction="#showContracts"
                        styleClass="fo-nav-link, fo-nav-link-active"/>
                <Button fx:id="btnMatching" text="🎯 IA Matching"
                        onAction="#showMatching"
                        styleClass="fo-nav-link"/>
                <Button fx:id="btnCharts" text="📊 Graphiques"
                        onAction="#showCharts"
                        styleClass="fo-nav-link"/>
                <Button fx:id="btnComparator" text="⚖️ Comparateur"
                        onAction="#showComparator"
                        styleClass="fo-nav-link"/>
                <Button fx:id="btnRatings" text="⭐ Évaluations"
                        onAction="#showRatings"
                        styleClass="fo-nav-link"/>
            </HBox>

            <!-- ═══ DYNAMIC CONTENT AREA ═══ -->
            <FlowPane fx:id="contentArea" hgap="20" vgap="20"
                      alignment="CENTER"
                      style="-fx-padding: 30 40;">
                <!-- Content dynamically loaded by controller -->
            </FlowPane>

        </VBox>
    </ScrollPane>

</StackPane>
