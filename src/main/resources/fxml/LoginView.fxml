<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.najahni.controllers.LoginController"
      alignment="CENTER" spacing="0"
      styleClass="login-background"
      prefWidth="900" prefHeight="600">

    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">

        <!-- Left Panel — Branding -->
        <VBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS"
              styleClass="login-branding" style="-fx-padding: 40;">
            <Label text="🏦 NAJAHNI" styleClass="login-branding-title"/>
            <Label text="Plateforme Fintech" styleClass="login-branding-subtitle"/>
            <Label text="Entrepreneuriat &amp; Investissement" styleClass="login-branding-feature"/>

            <Region prefHeight="20"/>

            <Label text="📊 Analyse de risque IA" styleClass="login-branding-feature"/>
            <Label text="💱 Conversion multi-devises" styleClass="login-branding-feature"/>
            <Label text="📅 Suivi intelligent des deadlines" styleClass="login-branding-feature"/>
            <Label text="💳 Paiement sécurisé Stripe" styleClass="login-branding-feature"/>
        </VBox>

        <!-- Right Panel — Login Form -->
        <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS"
              style="-fx-padding: 40;">
            <VBox styleClass="login-form-card" spacing="20" alignment="CENTER"
                  maxWidth="360">

                <Label text="Connexion" styleClass="login-title"/>
                <Label text="Accédez à votre espace" styleClass="login-subtitle"/>

                <Region prefHeight="5"/>

                <!-- Email -->
                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="📧 Email" styleClass="form-label"/>
                    <TextField fx:id="txtEmail" promptText="votre@email.com"
                               styleClass="login-field"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="🔒 Mot de passe" styleClass="form-label"/>
                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                   styleClass="login-field"/>
                </VBox>

                <!-- Error Label -->
                <Label fx:id="lblError" text="" styleClass="login-status" wrapText="true"/>

                <!-- Login Button -->
                <Button fx:id="btnLogin" text="Se connecter" onAction="#handleLogin" maxWidth="Infinity"
                        styleClass="login-btn"/>

                <Region prefHeight="5"/>

                <Label text="v3.0 — Fintech Platform" styleClass="login-link"/>
            </VBox>
        </VBox>

    </HBox>

</VBox>
