<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.FrontPortfolioController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="front-scroll"
            style="-fx-background-color: transparent;">
<content>
<VBox spacing="25" styleClass="front-page">

    <padding>
        <Insets top="25" right="30" bottom="30" left="30"/>
    </padding>

    <!-- ═══════════════════════════════════════════════════
         HERO BANNER
         ═══════════════════════════════════════════════════ -->
    <VBox spacing="8" alignment="CENTER"
          style="-fx-background-color: linear-gradient(to right, #0f3460, #16213e, #1a1a2e);
                 -fx-background-radius: 18; -fx-padding: 35 40;
                 -fx-effect: dropshadow(gaussian, rgba(15,52,96,0.4), 20, 0, 0, 6);">
        <Label text="💼 Mon Portefeuille d'Investissements"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Suivi de vos investissements payés et confirmés"
               style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.7);"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         STATS DASHBOARD
         ═══════════════════════════════════════════════════ -->
    <HBox spacing="15" alignment="CENTER">
        <!-- Total investi -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #27ae60 transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="💰" style="-fx-font-size: 28px;"/>
            <Label text="Total Investi" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalInvested" text="0,00 €"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <!-- Nombre d'investissements -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #3498db transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="📊" style="-fx-font-size: 28px;"/>
            <Label text="Investissements" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalCount" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </VBox>

        <!-- Montant moyen -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #8e44ad transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="📈" style="-fx-font-size: 28px;"/>
            <Label text="Montant Moyen" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
            <Label fx:id="lblAvgAmount" text="0,00 €"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #8e44ad;"/>
        </VBox>
    </HBox>

    <!-- ═══════════════════════════════════════════════════
         INVESTMENTS LIST
         ═══════════════════════════════════════════════════ -->
    <VBox spacing="15"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-padding: 25 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🏦 Mes Investissements Confirmés"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#refreshPortfolio"
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand;
                           -fx-font-size: 12px; -fx-border-color: #3498db; -fx-border-width: 1;
                           -fx-border-radius: 8; -fx-padding: 6 14; -fx-background-radius: 8;"/>
        </HBox>

        <FlowPane fx:id="portfolioContainer" hgap="18" vgap="18" alignment="CENTER_LEFT"/>

        <VBox fx:id="emptyState" spacing="10" alignment="CENTER" visible="false" managed="false"
              style="-fx-padding: 40 20;">
            <Label text="📭" style="-fx-font-size: 48px;"/>
            <Label text="Aucun investissement pour le moment"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
            <Label text="Vos investissements payés apparaîtront ici."
                   style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
        </VBox>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15 0;">
        <Label text="💼 NAJAHNI — Portefeuille d'investissements"
               style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;"/>
    </HBox>

</VBox>
</content>
</ScrollPane>
