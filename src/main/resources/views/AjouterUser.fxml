<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.AjouterUserController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Ajouter un utilisateur" styleClass="page-header-title"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" style="-fx-padding: 35;">
            <VBox styleClass="glass-card" spacing="18" alignment="CENTER" maxWidth="520">
                <padding><Insets top="35" right="40" bottom="35" left="40"/></padding>

                <Label text="Nouvel utilisateur" styleClass="page-title"/>
                <Label text="Remplissez les informations ci-dessous" styleClass="page-subtitle"/>

                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Prénom" styleClass="field-label"/>
                        <TextField fx:id="firstnameField" promptText="Prénom"
                                   styleClass="modern-field" prefHeight="44"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Nom" styleClass="field-label"/>
                        <TextField fx:id="lastnameField" promptText="Nom"
                                   styleClass="modern-field" prefHeight="44"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="exemple@email.com"
                               styleClass="modern-field" prefHeight="44"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Téléphone" styleClass="field-label"/>
                    <TextField fx:id="phoneField" promptText="+216 XX XXX XXX"
                               styleClass="modern-field" prefHeight="44"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="Minimum 6 caractères"
                                   styleClass="modern-field" prefHeight="44"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Rôle" styleClass="field-label"/>
                    <ComboBox fx:id="roleComboBox" styleClass="modern-combo"
                              prefHeight="44" maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="error-label"/>
                <Label fx:id="successLabel" visible="false" wrapText="true" styleClass="success-label"/>

                <Button text="Ajouter l'utilisateur" onAction="#handleAdd"
                        styleClass="btn-success-gradient" prefHeight="48" prefWidth="320"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
