<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.community.CommunityAdminController"
           stylesheets="@../najahni-master.css"
           style="-fx-background-color: #f4f5f7;">

    <VBox spacing="0">

        <!-- ══ HEADER BAR ══ -->
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 16 28 12 28;"
              spacing="2">
            <Label text="🏘 Communauté — Administration"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Gérer les groupes, publications, threads et événements"
                   style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11;"/>
        </VBox>

        <!-- ══ TAB BAR ══ -->
        <HBox spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 8 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">

            <Button fx:id="tabDashboard" text="📊 Dashboard"
                    styleClass="community-admin-tab" onAction="#showDashboard"/>
            <Button fx:id="tabGroups" text="👥 Groupes"
                    styleClass="community-admin-tab" onAction="#showGroups"/>
            <Button fx:id="tabPosts" text="📝 Publications"
                    styleClass="community-admin-tab" onAction="#showPosts"/>
            <Button fx:id="tabThreads" text="💬 Threads"
                    styleClass="community-admin-tab" onAction="#showThreads"/>
            <Button fx:id="tabEvents" text="📅 Événements"
                    styleClass="community-admin-tab" onAction="#showEvents"/>
        </HBox>

        <!-- ══ CONTENT AREA ══ -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #f4f5f7;">
            <padding><Insets top="0"/></padding>
        </StackPane>

    </VBox>

</StackPane>
