<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.HomeController"
            stylesheets="@najahni-master.css"
            styleClass="fo-root"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ═══ TOP NAVBAR — Premium Dark ═══ -->
    <top>
        <HBox styleClass="fo-navbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="28" bottom="10" left="28"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8" onMouseClicked="#handleHomeRefresh"
                  styleClass="fo-logo-container">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <image><Image url="@logo_najahni.png"/></image>
                </ImageView>
                <Label text="NAJAHNI" styleClass="fo-navbar-brand" mouseTransparent="true"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Utility buttons -->
            <Button text="&#x1f319;" onAction="#handleThemeToggle" styleClass="fo-nav-link" style="-fx-font-size: 15px;">
                <tooltip><Tooltip text="Theme sombre/clair"/></tooltip>
            </Button>
            <StackPane>
                <Button text="&#x1f514;" onAction="#handleNotifications" styleClass="fo-nav-link" style="-fx-font-size: 15px;">
                    <tooltip><Tooltip text="Notifications"/></tooltip>
                </Button>
                <Label fx:id="notificationBadge" text="0" visible="false"
                       styleClass="notification-badge"
                       StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
            </StackPane>
            <Button fx:id="btnToggleScreen" text="&#x26F6;" onAction="#handleToggleScreen" styleClass="fo-nav-link" style="-fx-font-size: 16px;"/>

            <Region prefWidth="8"/>

            <Button text="Mon Profil" onAction="#handleProfile" styleClass="fo-nav-link"/>
            <Button text="Reseau" onAction="#handleNetwork" styleClass="fo-nav-link"/>
            <Button text="Mot de passe" onAction="#handleChangePassword" styleClass="fo-nav-link"/>
            <Button text="&#x1f4cb; Historique" onAction="#handleLoginHistory" styleClass="fo-nav-link"/>

            <Region prefWidth="8"/>

            <Button text="&#x1f6aa; Deconnexion" onAction="#handleLogout" styleClass="fo-btn-logout"/>
        </HBox>
    </top>

    <!-- ═══ CENTER CONTENT ═══ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="front-scroll">
        <VBox spacing="28" style="-fx-background-color: #f8fafc;">
            <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>

            <!-- Hero Banner -->
            <VBox styleClass="fo-hero-banner" spacing="8">
                <Label fx:id="welcomeLabel" text="Bienvenue !" styleClass="fo-hero-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Role :" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                    <Label fx:id="roleLabel" text="" styleClass="front-badge, front-badge-blue"/>
                </HBox>
                <Label text="Explorez les modules de la plateforme Najahni"
                       styleClass="fo-hero-subtitle"/>
            </VBox>

            <!-- Stats Row -->
            <HBox spacing="20" alignment="CENTER">
                <VBox styleClass="fo-stat-card, fo-stat-card-blue" alignment="CENTER" spacing="4"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="followersCountLabel" text="0" styleClass="fo-stat-value, fo-stat-value-blue"/>
                    <Label text="ABONNES" styleClass="fo-stat-label"/>
                </VBox>
                <VBox styleClass="fo-stat-card, fo-stat-card-green" alignment="CENTER" spacing="4"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="followingCountLabel" text="0" styleClass="fo-stat-value, fo-stat-value-green"/>
                    <Label text="ABONNEMENTS" styleClass="fo-stat-label"/>
                </VBox>
            </HBox>

            <!-- Module Navigation Cards -->
            <Label text="&#x1f680; Modules" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <HBox spacing="16" alignment="CENTER">
                <VBox styleClass="home-module-card" alignment="CENTER" spacing="10"
                      onMouseClicked="#handleCommunity" HBox.hgrow="ALWAYS">
                    <Label text="&#x1f3d8;" styleClass="home-module-icon"/>
                    <Label text="Communaute" styleClass="home-module-title"/>
                </VBox>
                <VBox styleClass="home-module-card" alignment="CENTER" spacing="10"
                      onMouseClicked="#handleInvestissement" HBox.hgrow="ALWAYS">
                    <Label text="&#x1f4b0;" styleClass="home-module-icon"/>
                    <Label text="Investissement" styleClass="home-module-title"/>
                </VBox>
                <VBox styleClass="home-module-card" alignment="CENTER" spacing="10"
                      onMouseClicked="#handleMentorat" HBox.hgrow="ALWAYS">
                    <Label text="&#x1f393;" styleClass="home-module-icon"/>
                    <Label text="Mentorat" styleClass="home-module-title"/>
                </VBox>
                <VBox styleClass="home-module-card" alignment="CENTER" spacing="10"
                      onMouseClicked="#handleProjets" HBox.hgrow="ALWAYS">
                    <Label text="&#x1f4ca;" styleClass="home-module-icon"/>
                    <Label text="Projets" styleClass="home-module-title"/>
                </VBox>
                <VBox styleClass="home-module-card" alignment="CENTER" spacing="10"
                      onMouseClicked="#handleApprentissage" HBox.hgrow="ALWAYS">
                    <Label text="&#x1f4da;" styleClass="home-module-icon"/>
                    <Label text="Apprentissage" styleClass="home-module-title"/>
                </VBox>
            </HBox>

            <!-- Suggestions Section -->
            <VBox spacing="14" style="-fx-padding: 10 0 0 0;">
                <Label text="&#x1f465; Suggestions pour vous"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <VBox fx:id="suggestionsBox" spacing="8" style="-fx-padding: 5;">
                    <Label text="Chargement..." style="-fx-text-fill: #64748b;"/>
                </VBox>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>