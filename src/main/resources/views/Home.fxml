<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="controllers.HomeController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP NAV -->
    <top>
        <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <ImageView fitWidth="34" fitHeight="34" preserveRatio="true">
                <image><Image url="@logo_najahni.png"/></image>
            </ImageView>
            <Label text="NAJAHNI" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- New Feature Buttons -->
            <Button text="🌙" onAction="#handleThemeToggle" styleClass="btn-nav" style="-fx-font-size: 15px;">
                <tooltip><Tooltip text="Thème sombre/clair"/></tooltip>
            </Button>
            <StackPane>
                <Button text="🔔" onAction="#handleNotifications" styleClass="btn-nav" style="-fx-font-size: 15px;">
                    <tooltip><Tooltip text="Notifications"/></tooltip>
                </Button>
                <Label fx:id="notificationBadge" text="0" visible="false"
                       style="-fx-background-color: #E17055; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-padding: 1 5; -fx-min-width: 18; -fx-min-height: 18; -fx-alignment: center;"
                       StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
            </StackPane>

            <Button fx:id="btnToggleScreen" text="⛶" onAction="#handleToggleScreen" styleClass="btn-nav" style="-fx-font-size: 16px;"/>
            <Button text="Mon Profil" onAction="#handleProfile" styleClass="btn-nav"/>
            <Button text="Réseau" onAction="#handleNetwork" styleClass="btn-nav-accent"/>
            <Button text="Mot de passe" onAction="#handleChangePassword" styleClass="btn-nav"/>
            <Button text="📋 Historique" onAction="#handleLoginHistory" styleClass="btn-nav"/>
            <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-nav-danger"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="modern-scroll"
                    style="-fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="35">
            <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

            <Label fx:id="welcomeLabel" text="Bienvenue !" styleClass="page-title"
                   style="-fx-font-size: 36px;"/>

            <HBox spacing="8" alignment="CENTER">
                <Label text="Rôle :" styleClass="text-muted" style="-fx-font-size: 16px;"/>
                <Label fx:id="roleLabel" text="" styleClass="profile-badge"/>
            </HBox>

            <HBox spacing="40" alignment="CENTER">
                <VBox alignment="CENTER" spacing="8" styleClass="counter-box">
                    <Label fx:id="followersCountLabel" text="0" styleClass="counter-value"
                           style="-fx-text-fill: #6C63FF;"/>
                    <Label text="Abonnés" styleClass="counter-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="8" styleClass="counter-box">
                    <Label fx:id="followingCountLabel" text="0" styleClass="counter-value"
                           style="-fx-text-fill: #00B894;"/>
                    <Label text="Abonnements" styleClass="counter-label"/>
                </VBox>
            </HBox>

            <Label text="Connectez-vous avec des entrepreneurs, mentors et investisseurs."
                   styleClass="text-muted" style="-fx-font-size: 15px;" wrapText="true"
                   textAlignment="CENTER" maxWidth="500"/>

            <!-- Suggestions Section -->
            <VBox spacing="12" alignment="CENTER" maxWidth="500" style="-fx-padding: 10 0 0 0;">
                <Label text="👥 Suggestions pour vous" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                <VBox fx:id="suggestionsBox" spacing="8" style="-fx-padding: 5;">
                    <Label text="Chargement..." styleClass="text-muted"/>
                </VBox>
            </VBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
