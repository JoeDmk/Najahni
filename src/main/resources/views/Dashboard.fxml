<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.DashboardController"
            stylesheets="@najahni.css"
            prefWidth="1100" prefHeight="700">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="dashboard-topbar" alignment="CENTER_LEFT" spacing="15">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                <image><Image url="@logo_najahni.png"/></image>
            </ImageView>
            <Label text="NAJAHNI" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Bienvenue, Admin" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button text="Mon Profil" onAction="#handleMyProfile" styleClass="btn-topbar"/>
            <Button text="Statistiques" onAction="#handleStats" styleClass="btn-topbar-accent"/>
            <Button text="Déconnexion" onAction="#handleLogout" styleClass="btn-topbar-danger"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-background-color: #f5f6fa;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- Stats Cards -->
            <HBox spacing="15" alignment="CENTER">
                <VBox alignment="CENTER" styleClass="stat-card" style="-fx-border-color: #3498db;">
                    <Label text="Total" styleClass="stat-label"/>
                    <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #3498db;"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="stat-card" style="-fx-border-color: #2ecc71;">
                    <Label text="Entrepreneurs" styleClass="stat-label"/>
                    <Label fx:id="entrepreneursLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #2ecc71;"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="stat-card" style="-fx-border-color: #f39c12;">
                    <Label text="Mentors" styleClass="stat-label"/>
                    <Label fx:id="mentorsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #f39c12;"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="stat-card" style="-fx-border-color: #9b59b6;">
                    <Label text="Investisseurs" styleClass="stat-label"/>
                    <Label fx:id="investisseursLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #9b59b6;"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="stat-card" style="-fx-border-color: #e74c3c;">
                    <Label text="Bannis" styleClass="stat-label"/>
                    <Label fx:id="bannedLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #e74c3c;"/>
                </VBox>
            </HBox>

            <!-- Content - Split View -->
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                
                <!-- Users Table -->
                <VBox HBox.hgrow="ALWAYS" spacing="10">
                    <Label text="Liste des Utilisateurs" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>
                    
                    <!-- Search/Filter Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Rechercher par nom ou email..." prefWidth="250" prefHeight="35" styleClass="search-field"/>
                        <ComboBox fx:id="roleFilterCombo" prefHeight="35" prefWidth="150" styleClass="filter-combo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Ajouter" onAction="#handleAddUser" styleClass="btn-primary"/>
                        <Button text="🔄" onAction="#refreshData" styleClass="btn-secondary" prefHeight="35"/>
                    </HBox>
                    
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="users-table">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" minWidth="50"/>
                            <TableColumn fx:id="firstnameColumn" text="Prénom" prefWidth="120" minWidth="100"/>
                            <TableColumn fx:id="lastnameColumn" text="Nom" prefWidth="120" minWidth="100"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" minWidth="150"/>
                            <TableColumn fx:id="phoneColumn" text="Téléphone" prefWidth="120" minWidth="90"/>
                            <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="110" minWidth="80"/>
                            <TableColumn fx:id="statusColumn" text="Statut" prefWidth="80" minWidth="60"/>
                            <TableColumn fx:id="verifiedColumn" text="Vérifié" prefWidth="70" minWidth="50"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun utilisateur trouvé"/>
                        </placeholder>
                    </TableView>
                </VBox>
                
                <!-- Action Panel -->
                <VBox fx:id="actionPanel" styleClass="action-panel" spacing="15" minWidth="250" maxWidth="250">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Actions" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>
                    <Separator/>
                    
                    <Label text="Sélectionnez un utilisateur dans le tableau pour effectuer une action." 
                           wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                    
                    <Region VBox.vgrow="ALWAYS"/>
                    
                    <Button text="👤 Voir Profil" onAction="#handleViewProfile" styleClass="btn-action" maxWidth="Infinity" prefHeight="38"/>
                    <Button text="🔒 Ban / Unban" onAction="#handleBanUser" styleClass="btn-action-warn" maxWidth="Infinity" prefHeight="38"/>
                    <Button text="🗑 Supprimer" onAction="#handleDeleteUser" styleClass="btn-action-danger" maxWidth="Infinity" prefHeight="38"/>
                </VBox>
                
            </HBox>
        </VBox>
    </center>
</BorderPane>
