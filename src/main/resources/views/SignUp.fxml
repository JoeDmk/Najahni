<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controllers.SignUpController"
      styleClass="auth-container"
      stylesheets="@najahni.css">
    
    <!-- Left Panel - Branding -->
    <VBox styleClass="auth-branding-panel" alignment="CENTER" spacing="25" HBox.hgrow="ALWAYS">
        <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>
        
        <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
            <image><Image url="@logo_najahni.png"/></image>
        </ImageView>
        <Label text="NAJAHNI" styleClass="auth-brand-title"/>
        <Label text="Rejoignez la communauté" styleClass="auth-brand-subtitle"/>
        
        <Separator styleClass="auth-separator" maxWidth="200"/>
        
        <Label text="Créez votre compte gratuitement et accédez à toutes les fonctionnalités de la plateforme." 
               styleClass="auth-brand-description" wrapText="true" maxWidth="320" textAlignment="CENTER"/>
        
        <VBox spacing="12" alignment="CENTER">
            <padding><Insets top="20"/></padding>
            <HBox alignment="CENTER" spacing="10">
                <Label text="✓" styleClass="auth-check"/>
                <Label text="Accès gratuit et illimité" styleClass="auth-feature"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="✓" styleClass="auth-check"/>
                <Label text="Communauté active" styleClass="auth-feature"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="✓" styleClass="auth-check"/>
                <Label text="Support dédié" styleClass="auth-feature"/>
            </HBox>
        </VBox>
    </VBox>
    
    <!-- Right Panel - Signup Form -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="auth-form-scroll" HBox.hgrow="ALWAYS">
        <VBox styleClass="auth-form-panel" alignment="CENTER" spacing="20">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>
            
            <VBox spacing="8" alignment="CENTER">
                <Label text="Créer un compte" styleClass="auth-title"/>
                <Label text="Remplissez le formulaire pour vous inscrire" styleClass="auth-subtitle"/>
            </VBox>
            
            <!-- Error/Success Message -->
            <Label fx:id="messageLabel" styleClass="auth-error" visible="false" managed="false"/>
            
            <!-- Signup Form -->
            <VBox spacing="18" maxWidth="400" alignment="CENTER">
                
                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Prénom *" styleClass="auth-label"/>
                        <TextField fx:id="firstnameField" promptText="Votre prénom" styleClass="auth-input" prefHeight="42"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Nom *" styleClass="auth-label"/>
                        <TextField fx:id="lastnameField" promptText="Votre nom" styleClass="auth-input" prefHeight="42"/>
                    </VBox>
                </HBox>
                
                <VBox spacing="6">
                    <Label text="Adresse email *" styleClass="auth-label"/>
                    <TextField fx:id="emailField" promptText="exemple@email.com" styleClass="auth-input" prefHeight="42"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Téléphone" styleClass="auth-label"/>
                    <TextField fx:id="phoneField" promptText="+216 XX XXX XXX" styleClass="auth-input" prefHeight="42"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Mot de passe *" styleClass="auth-label"/>
                    <PasswordField fx:id="passwordField" promptText="Minimum 6 caractères" styleClass="auth-input" prefHeight="42"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Confirmer le mot de passe *" styleClass="auth-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Retapez votre mot de passe" styleClass="auth-input" prefHeight="42"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Je suis un(e) *" styleClass="auth-label"/>
                    <ComboBox fx:id="roleComboBox" promptText="Sélectionnez votre rôle" styleClass="auth-combo" prefHeight="42" maxWidth="Infinity"/>
                </VBox>
                
                <Button fx:id="registerButton" text="Créer mon compte" styleClass="btn-auth-primary" 
                        onAction="#handleRegister" prefHeight="48" maxWidth="Infinity"/>
            </VBox>
            
            <Separator maxWidth="400"/>
            
            <HBox alignment="CENTER" spacing="5">
                <Label text="Déjà inscrit?" styleClass="auth-switch-text"/>
                <Hyperlink text="Se connecter" styleClass="auth-switch-link" onAction="#handleSignIn"/>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
