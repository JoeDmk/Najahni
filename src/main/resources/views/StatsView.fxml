<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.StatsController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Statistiques" styleClass="page-header-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" style="-fx-padding: 24;">

            <!-- Summary Cards -->
            <HBox spacing="18" alignment="CENTER">
                <VBox styleClass="stat-card-modern, stat-card-blue" alignment="CENTER" prefWidth="200">
                    <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
                    <Label text="Total Utilisateurs" styleClass="stat-card-label"/>
                    <Label fx:id="totalLabel" text="0" styleClass="stat-card-value"/>
                </VBox>
                <VBox styleClass="stat-card-modern, stat-card-green" alignment="CENTER" prefWidth="200">
                    <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
                    <Label text="Actifs" styleClass="stat-card-label"/>
                    <Label fx:id="activeLabel" text="0" styleClass="stat-card-value"/>
                </VBox>
                <VBox styleClass="stat-card-modern, stat-card-red" alignment="CENTER" prefWidth="200">
                    <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
                    <Label text="Bannis" styleClass="stat-card-label"/>
                    <Label fx:id="bannedLabel" text="0" styleClass="stat-card-value"/>
                </VBox>
            </HBox>

            <!-- Charts -->
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox styleClass="glass-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <PieChart fx:id="rolesPieChart" title="Répartition par rôle"
                              style="-fx-legend-side: bottom;"/>
                </VBox>
                <VBox styleClass="glass-card" HBox.hgrow="ALWAYS">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <BarChart fx:id="statsBarChart" style="-fx-legend-visible: false;">
                        <xAxis><CategoryAxis label="Catégorie"/></xAxis>
                        <yAxis><NumberAxis label="Nombre"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
