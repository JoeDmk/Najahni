<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.StatsController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="← Retour" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Label text="  Statistiques" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 20; -fx-pref-width: 180;">
                    <Label text="Total" style="-fx-text-fill: white;"/>
                    <Label fx:id="totalLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-background-color: #2ecc71; -fx-background-radius: 10; -fx-padding: 20; -fx-pref-width: 180;">
                    <Label text="Actifs" style="-fx-text-fill: white;"/>
                    <Label fx:id="activeLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-padding: 20; -fx-pref-width: 180;">
                    <Label text="Bannis" style="-fx-text-fill: white;"/>
                    <Label fx:id="bannedLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <PieChart fx:id="rolesPieChart" title="Répartition par rôle" HBox.hgrow="ALWAYS"/>
                <BarChart fx:id="statsBarChart" HBox.hgrow="ALWAYS">
                    <xAxis><CategoryAxis label="Catégorie"/></xAxis>
                    <yAxis><NumberAxis label="Nombre"/></yAxis>
                </BarChart>
            </HBox>
        </VBox>
    </center>
</BorderPane>
