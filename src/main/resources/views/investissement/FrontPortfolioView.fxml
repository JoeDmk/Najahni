<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.investissement.FrontPortfolioController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="front-scroll">
<content>
<VBox spacing="25" styleClass="front-page">

    <padding>
        <Insets top="25" right="30" bottom="30" left="30"/>
    </padding>

    <!-- ═══════════════════════════════════════════════════
         HERO BANNER
         ═══════════════════════════════════════════════════ -->
    <VBox spacing="8" alignment="CENTER" styleClass="portfolio-hero">
        <Label text="💼 Mon Portfolio d'Investissements"
               styleClass="portfolio-hero-title"/>
        <Label text="Suivi de vos investissements payés et confirmés"
               styleClass="portfolio-hero-subtitle"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         STATS DASHBOARD
         ═══════════════════════════════════════════════════ -->
    <HBox spacing="15" alignment="CENTER">
        <!-- Total investi -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-green">
            <Label text="💰" styleClass="risk-indicator-emoji"/>
            <Label text="Total Investi" styleClass="fo-stat-label"/>
            <Label fx:id="lblTotalInvested" text="0,00 €"
                   styleClass="fo-stat-value, fo-stat-value-green"/>
        </VBox>

        <!-- Nombre d'investissements -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-blue">
            <Label text="📊" styleClass="risk-indicator-emoji"/>
            <Label text="Investissements" styleClass="fo-stat-label"/>
            <Label fx:id="lblTotalCount" text="0"
                   styleClass="fo-stat-value, fo-stat-value-blue"/>
        </VBox>

        <!-- Montant moyen -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-purple">
            <Label text="📈" styleClass="risk-indicator-emoji"/>
            <Label text="Montant Moyen" styleClass="fo-stat-label"/>
            <Label fx:id="lblAvgAmount" text="0,00 €"
                   styleClass="fo-stat-value, fo-stat-value-purple"/>
        </VBox>
    </HBox>

    <!-- ═══════════════════════════════════════════════════
         INVESTMENTS LIST
         ═══════════════════════════════════════════════════ -->
    <VBox spacing="15" styleClass="section-container">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🏦 Mes Investissements Confirmés"
                   styleClass="opportunity-form-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#refreshPortfolio"
                    styleClass="front-btn-secondary"/>
            <Button text="📄 Exporter PDF" onAction="#exportPortfolioPDF"
                    style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>

        <FlowPane fx:id="portfolioContainer" hgap="18" vgap="18" alignment="CENTER_LEFT"/>

        <VBox fx:id="emptyState" spacing="10" alignment="CENTER" visible="false" managed="false"
              style="-fx-padding: 40 20;">
            <Label text="📭" styleClass="empty-state-icon"/>
            <Label text="Aucun investissement pour le moment"
                   styleClass="empty-state-text"/>
            <Label text="Vos investissements payés apparaîtront ici."
                   styleClass="empty-state-subtext"/>
        </VBox>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 15 0;">
        <Label text="💼 NAJAHNI — Portfolio d'investissements"
               styleClass="empty-state-subtext"/>
    </HBox>

</VBox>
</content>
</ScrollPane>
