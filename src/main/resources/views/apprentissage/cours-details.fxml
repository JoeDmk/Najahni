<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="controllers.apprentissage.FrontOfficeCoursDetailsController"
 fitToWidth="true" fitToHeight="true"
 hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
 style="-fx-background-color: transparent; -fx-padding: 0;">
 <content>
 <VBox spacing="0" style="-fx-background-color: #f5f6fa;">

 <!-- Hero Banner -->
 <VBox fx:id="heroBanner" spacing="12" alignment="CENTER_LEFT"
 style="-fx-background-color: linear-gradient(to right, #2c3e50, #3498db);
 -fx-padding: 35 30 35 30;">

 <!-- Back Button -->
 <Button text="← Retour au catalogue" onAction="#goBack"
 style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
 -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand;
 -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 20; -fx-font-size: 12px;"/>

 <HBox spacing="12" alignment="CENTER_LEFT">
 <Label fx:id="lblTypeIcon" text=""
 style="-fx-font-size: 36px;"/>
 <VBox spacing="6">
 <Label fx:id="lblTitre" text="Titre du Cours"
 style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true;"/>
 <HBox spacing="10">
 <Label fx:id="lblNiveau" text="Débutant"
 style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
 -fx-padding: 3 10; -fx-background-radius: 20; -fx-font-size: 12px;"/>
 <Label fx:id="lblType" text="Texte"
 style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
 -fx-padding: 3 10; -fx-background-radius: 20; -fx-font-size: 12px;"/>
 <Label fx:id="lblCertifBadge" text="Certifiant"
 style="-fx-background-color: #f39c12; -fx-text-fill: white;
 -fx-padding: 3 10; -fx-background-radius: 20; -fx-font-size: 12px;"
 visible="false" managed="false"/>
 </HBox>
 </VBox>
 </HBox>
 </VBox>

 <!-- Main Content -->
 <HBox spacing="0" style="-fx-background-color: #f5f6fa;">

 <!-- Left Column: Description & Content -->
 <VBox spacing="20" HBox.hgrow="ALWAYS"
 style="-fx-padding: 25 20 25 30;">

 <!-- Description Card -->
 <VBox spacing="12"
 style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12;
 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
 <Label text="Description"
 style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
 <Separator/>
 <Label fx:id="lblDescription" text=""
 style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-wrap-text: true; -fx-line-spacing: 4;"/>
 </VBox>

 <!-- Objectives Card (placeholder) -->
 <VBox spacing="12"
 style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12;
 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
 <Label text="Objectifs du cours"
 style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
 <Separator/>
 <Label text="• Comprendre les concepts fondamentaux du domaine"
 style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
 <Label text="• Appliquer les connaissances dans des cas pratiques"
 style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
 <Label text="• Obtenir une certification reconnue (si applicable)"
 style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
 </VBox>

 <!-- Comments Section -->
 <VBox spacing="14"
 style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12;
 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
 <Label text="Commentaires"
 style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
 <Separator/>

 <!-- Add Comment -->
 <HBox spacing="10" alignment="CENTER_LEFT">
 <TextArea fx:id="txtCommentInput" promptText="Écrire un commentaire..."
 prefRowCount="2" wrapText="true"
 HBox.hgrow="ALWAYS"
 style="-fx-font-size: 13px; -fx-border-color: #ddd; -fx-border-radius: 8;
 -fx-background-radius: 8; -fx-padding: 8;"/>
 <Button text="Envoyer" onAction="#ajouterCommentaire"
 style="-fx-background-color: #3498db; -fx-text-fill: white;
 -fx-background-radius: 8; -fx-padding: 10 18;
 -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
 </HBox>

 <!-- Comments List -->
 <VBox fx:id="vboxCommentsList" spacing="10">
 <!-- Comments will be dynamically added here -->
 </VBox>
 </VBox>

 </VBox>

 <!-- Right Column: Info Card + Actions -->
 <VBox spacing="16" minWidth="270" maxWidth="270"
 style="-fx-padding: 25 30 25 10;">

 <!-- Stats Card -->
 <VBox spacing="0"
 style="-fx-background-color: white; -fx-background-radius: 12;
 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">

 <!-- QR Code (shown only for QUIZ type) -->
 <VBox fx:id="vboxQRCode" spacing="8" alignment="CENTER"
 visible="false" managed="false"
 style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
 <Label text="Scanner pour accéder au quiz"
 style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-text-alignment: center;"/>
 <ImageView fx:id="imgQRCode" fitWidth="180" fitHeight="180" preserveRatio="true"/>
 <Label text="Scannez avec votre téléphone"
 style="-fx-font-size: 10px; -fx-text-fill: #bdc3c7; -fx-text-alignment: center;"/>
 </VBox>

 <!-- XP Row -->
 <HBox spacing="12" alignment="CENTER_LEFT"
 style="-fx-padding: 16 18; -fx-border-color: transparent transparent #f0f0f0 transparent;">
 <Label text="" style="-fx-font-size: 20px;"/>
 <VBox spacing="2">
 <Label text="Points XP" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
 <Label fx:id="lblXP" text="0 XP"
 style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
 </VBox>
 </HBox>

 <!-- Duration Row -->
 <HBox spacing="12" alignment="CENTER_LEFT"
 style="-fx-padding: 16 18; -fx-border-color: transparent transparent #f0f0f0 transparent;">
 <Label text="" style="-fx-font-size: 20px;"/>
 <VBox spacing="2">
 <Label text="Durée estimée" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
 <Label fx:id="lblDuree" text="— min"
 style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
 </VBox>
 </HBox>

 <!-- Attachment Row -->
 <HBox spacing="12" alignment="CENTER_LEFT"
 style="-fx-padding: 16 18; -fx-border-color: transparent transparent #f0f0f0 transparent;">
 <Label fx:id="lblDocumentIcon" text="" style="-fx-font-size: 20px;"/>
 <VBox spacing="2">
 <Label fx:id="lblDocumentLabel" text="Pièce jointe"
 style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
 <Label fx:id="lblDocument" text="Aucun fichier joint"
 style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
 </VBox>
 </HBox>

 <Button fx:id="btnCompleterCours" text="J'ai terminé ce cours" onAction="#completerCours"
 maxWidth="Infinity"
 visible="false" managed="false"
 style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;
 -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14;
 -fx-cursor: hand;"/>

 <Label fx:id="lblCompletionStatus" text=""
 style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-text-alignment: center;"
 visible="false" managed="false"/>

 <!-- Certification Row -->
 <HBox spacing="12" alignment="CENTER_LEFT"
 style="-fx-padding: 16 18;">
 <Label text="" style="-fx-font-size: 20px;"/>
 <VBox spacing="2">
 <Label text="Certification" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
 <Label fx:id="lblCertification" text="Non certifiant"
 style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
 </VBox>
 </HBox>
 </VBox>

 <!-- CTA Button -->
 <Button text="Commencer le cours" onAction="#startCours"
 maxWidth="Infinity"
 style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;
 -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14;
 -fx-cursor: hand;"/>

 <!-- Open Document Button (hidden by default, shown if attachment exists) -->
 <Button fx:id="btnOpenDocument" text="Ouvrir le document" onAction="#openDocument"
 maxWidth="Infinity"
 visible="false" managed="false"
 style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 13px;
 -fx-background-radius: 10; -fx-padding: 10; -fx-cursor: hand;"/>

 <!-- Delete Button -->
 <Button fx:id="btnDelete" text="Supprimer ce cours" onAction="#deleteCours"
 maxWidth="Infinity"
 style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px;
 -fx-background-radius: 10; -fx-padding: 10; -fx-cursor: hand;"/>

 </VBox>
 </HBox>

 </VBox>
 </content>
</ScrollPane>
