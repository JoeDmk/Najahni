<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="root"
            fx:controller="controllers.apprentissage.DocumentViewerController"
            style="-fx-background-color: #2c3e50;">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 10 20;">
            <Label fx:id="lblTitle" text="Document"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fermer" onAction="#closeViewer"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-padding: 6 18;
                           -fx-font-size: 12px; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- WebView fills remaining space -->
    <center>
        <WebView fx:id="webView"/>
    </center>

</BorderPane>
