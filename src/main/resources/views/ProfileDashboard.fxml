<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:controller="controllers.ProfileDashboardController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Profil Utilisateur" styleClass="page-header-title"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="modern-scroll">
            <VBox alignment="CENTER" style="-fx-padding: 30;">
                <VBox styleClass="profile-card" spacing="20" maxWidth="580">
                    <padding><Insets top="35" right="40" bottom="35" left="40"/></padding>

                    <!-- Profile Picture -->
                    <HBox alignment="CENTER">
                        <StackPane fx:id="profileImageContainer" prefWidth="104" prefHeight="104"
                                   style="-fx-background-color: #E8E8E8; -fx-background-radius: 52;">
                            <Label fx:id="lblInitials" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #999;"/>
                            <ImageView fx:id="profileImageView" fitWidth="104" fitHeight="104"
                                       preserveRatio="false" visible="false"/>
                        </StackPane>
                    </HBox>

                    <!-- Name -->
                    <Label fx:id="nameLabel" styleClass="profile-name"/>

                    <!-- Counters -->
                    <HBox spacing="20" alignment="CENTER">
                        <VBox styleClass="counter-box" alignment="CENTER" prefWidth="150">
                            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                            <Label fx:id="followersLabel" text="0" styleClass="counter-value"
                                   style="-fx-text-fill: #6C63FF;"/>
                            <Label text="Abonnés" styleClass="counter-label"/>
                        </VBox>
                        <VBox styleClass="counter-box" alignment="CENTER" prefWidth="150">
                            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                            <Label fx:id="followingLabel" text="0" styleClass="counter-value"
                                   style="-fx-text-fill: #00B894;"/>
                            <Label text="Abonnements" styleClass="counter-label"/>
                        </VBox>
                    </HBox>

                    <!-- Fields -->
                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Email" styleClass="profile-field-label" prefWidth="140"/>
                            <Label fx:id="emailLabel" styleClass="profile-field-value"/>
                            <Label fx:id="emailVerifiedBadge" style="-fx-font-size: 13;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Téléphone" styleClass="profile-field-label" prefWidth="140"/>
                            <Label fx:id="phoneLabel" styleClass="profile-field-value"/>
                            <Label fx:id="phoneVerifiedBadge" style="-fx-font-size: 13;"/>
                        </HBox>
                        <HBox spacing="10"><Label text="Rôle" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="roleLabel" styleClass="role-badge"/></HBox>
                        <HBox spacing="10"><Label text="Bio" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="bioLabel" styleClass="profile-field-value" wrapText="true"/></HBox>
                        <HBox spacing="10"><Label text="Entreprise" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="companyLabel" styleClass="profile-field-value"/></HBox>
                        <HBox spacing="10"><Label text="LinkedIn" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="linkedinLabel" styleClass="profile-field-value"/></HBox>
                        <HBox spacing="10"><Label text="Adresse" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="addressLabel" styleClass="profile-field-value"/></HBox>
                        <HBox spacing="10"><Label text="Date de naissance" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="dobLabel" styleClass="profile-field-value"/></HBox>
                        <HBox spacing="10"><Label text="Statut" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="statusLabel" styleClass="profile-field-value"/></HBox>
                        <HBox spacing="10"><Label text="Vérifié" styleClass="profile-field-label" prefWidth="140"/><Label fx:id="verifiedLabel" styleClass="verified-badge"/></HBox>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
