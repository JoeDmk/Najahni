<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="controllers.ProfilController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Mon Profil" styleClass="page-header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER">
                <Label text="Rôle :" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
                <Label fx:id="roleLabel" styleClass="role-badge"/>
            </HBox>
            <Label fx:id="verifiedLabel" styleClass="verified-badge"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="modern-scroll">
            <VBox alignment="CENTER" style="-fx-padding: 30;">
                <VBox styleClass="glass-card" spacing="18" maxWidth="620">
                    <padding><Insets top="35" right="40" bottom="35" left="40"/></padding>

                    <!-- Profile Image - Circular -->
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane fx:id="profileImageContainer" alignment="CENTER"
                                   style="-fx-cursor: hand;" prefWidth="110" prefHeight="110">
                            <Circle fx:id="profileImageClip" radius="52" stroke="#6C63FF" strokeWidth="2.5"
                                    fill="#E8E8FF"/>
                            <Label fx:id="lblUploadHint" text="📷" style="-fx-font-size: 30px;"/>
                            <ImageView fx:id="profileImageView" fitWidth="104" fitHeight="104"
                                       preserveRatio="false" visible="false"/>
                        </StackPane>
                        <Label text="Cliquez pour changer la photo" styleClass="text-muted"
                               style="-fx-font-size: 11px;"/>
                    </VBox>

                    <Label text="Informations personnelles" styleClass="page-title" style="-fx-font-size: 22px;"/>

                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Prénom" styleClass="field-label"/>
                            <TextField fx:id="firstnameField" styleClass="modern-field" prefHeight="44"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nom" styleClass="field-label"/>
                            <TextField fx:id="lastnameField" styleClass="modern-field" prefHeight="44"/>
                        </VBox>
                    </HBox>

                    <!-- Email with verification status -->
                    <VBox spacing="6">
                        <Label text="Email" styleClass="field-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="emailField" styleClass="modern-field" prefHeight="44"
                                       HBox.hgrow="ALWAYS"/>
                            <Label fx:id="emailVerifiedBadge" style="-fx-font-size: 12px; -fx-padding: 4 10;"/>
                            <Button fx:id="btnVerifyEmail" text="Vérifier" onAction="#handleVerifyEmail"
                                    styleClass="btn-outline" prefHeight="36" visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <!-- Phone with verification status -->
                    <VBox spacing="6">
                        <Label text="Téléphone" styleClass="field-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="phoneField" styleClass="modern-field" prefHeight="44"
                                       HBox.hgrow="ALWAYS"/>
                            <Label fx:id="phoneVerifiedBadge" style="-fx-font-size: 12px; -fx-padding: 4 10;"/>
                            <Button fx:id="btnVerifyPhone" text="Vérifier" onAction="#handleVerifyPhone"
                                    styleClass="btn-outline" prefHeight="36" visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Bio" styleClass="field-label"/>
                        <TextArea fx:id="bioField" styleClass="modern-textarea" prefHeight="85"
                                  wrapText="true"/>
                    </VBox>

                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Entreprise" styleClass="field-label"/>
                            <TextField fx:id="companyField" styleClass="modern-field" prefHeight="44"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="LinkedIn" styleClass="field-label"/>
                            <TextField fx:id="linkedinField" styleClass="modern-field" prefHeight="44"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Adresse" styleClass="field-label"/>
                            <TextField fx:id="addressField" styleClass="modern-field" prefHeight="44"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Date de naissance" styleClass="field-label"/>
                            <DatePicker fx:id="dateOfBirthPicker" prefHeight="44" maxWidth="Infinity"
                                        style="-fx-background-radius: 12;"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="error-label"/>
                    <Label fx:id="successLabel" visible="false" wrapText="true" styleClass="success-label"/>

                    <HBox spacing="14" alignment="CENTER">
                        <Button text="Enregistrer" onAction="#handleSaveProfile"
                                styleClass="btn-success-gradient" prefHeight="46" prefWidth="220"/>
                        <Button text="Changer mot de passe" onAction="#handleChangePassword"
                                styleClass="btn-primary-gradient" prefHeight="46" prefWidth="220"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
