<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.EmailCodeController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Vérification Email" styleClass="page-header-title"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <VBox styleClass="glass-card" spacing="22" maxWidth="420" alignment="CENTER">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <Label text="✉" style="-fx-font-size: 48px;"/>
                <Label text="Vérification par email" styleClass="page-title" style="-fx-font-size: 22px;"/>
                <Label fx:id="infoLabel" text="Un code a été envoyé à votre email."
                       wrapText="true" styleClass="page-subtitle" style="-fx-text-alignment: center;"/>

                <TextField fx:id="codeField" styleClass="modern-field" prefHeight="52"
                           promptText="Code de vérification" alignment="CENTER"
                           style="-fx-font-size: 22px; -fx-letter-spacing: 6px;"/>

                <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="error-label"/>

                <Button text="Vérifier" onAction="#handleVerify"
                        styleClass="btn-success-gradient" prefHeight="46" maxWidth="Infinity"/>

                <Button text="Vérifier plus tard" onAction="#handleSkip"
                        styleClass="btn-outline" prefHeight="40" maxWidth="Infinity"/>

                <Button text="Renvoyer le code" onAction="#handleResend" styleClass="link-primary"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
