<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.ChangePasswordController"
            prefHeight="400.0" prefWidth="500.0"
            style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="← Retour" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Label text="  Changer le mot de passe" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40;">
            <PasswordField fx:id="currentPasswordField" promptText="Mot de passe actuel" prefHeight="38"
                           style="-fx-background-radius: 20;"/>
            <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe" prefHeight="38"
                           style="-fx-background-radius: 20;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer nouveau mot de passe" prefHeight="38"
                           style="-fx-background-radius: 20;"/>

            <Label fx:id="errorLabel" visible="false" wrapText="true"/>
            <Label fx:id="successLabel" visible="false" wrapText="true"/>

            <Button text="Changer" onAction="#handleChangePassword" prefHeight="38" prefWidth="300"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 14;"/>
        </VBox>
    </center>
</BorderPane>
