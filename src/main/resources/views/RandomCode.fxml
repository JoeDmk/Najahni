<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.RandomCodeController"
            prefHeight="400.0" prefWidth="500.0"
            style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button text="← Retour" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Label text="  Code de vérification" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40;">
            <Label fx:id="infoLabel" text="Un code a été envoyé à votre email." wrapText="true"
                   style="-fx-font-size: 14; -fx-text-fill: #2c3e50;"/>

            <TextField fx:id="codeField" promptText="Entrez le code" prefHeight="38" prefWidth="300"
                       alignment="CENTER" style="-fx-background-radius: 20; -fx-font-size: 18;"/>

            <Label fx:id="errorLabel" visible="false" wrapText="true"/>

            <Button text="Vérifier" onAction="#handleVerify" prefHeight="38" prefWidth="300"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 14;"/>

            <Button text="Renvoyer le code" onAction="#handleResend"
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true; -fx-cursor: hand;"/>
        </VBox>
    </center>
</BorderPane>
