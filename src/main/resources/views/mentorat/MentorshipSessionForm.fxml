<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.mentorat.MentorshipSessionFormController" stylesheets="@../najahni-master.css">

    <top>
        <HBox styleClass="module-nav-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Retour" onAction="#handleGoBack" styleClass="module-back-btn"/>
            <Label text="Mentorat › Sessions › Formulaire" styleClass="module-nav-title" HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Accueil" onAction="#handleGoHome" styleClass="module-home-btn"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
           <VBox styleClass="form-container" spacing="20">
               <Label text="Session Details" styleClass="header-label"/>
               <GridPane hgap="20" vgap="15">
                   <Label text="Request ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                   <ComboBox fx:id="cbRequest" prefWidth="300" promptText="Select Request" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                   <Label text="Scheduled Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                   <DatePicker fx:id="dpScheduledDate" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                   <Label text="Scheduled Time (HH:MM):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                   <TextField fx:id="tfScheduledTime" promptText="14:00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                   <Label text="Duration (Minutes):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                   <TextField fx:id="tfDuration" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                   <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                   <ComboBox fx:id="cbStatus" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                   <Label text="Meeting Link:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                   <TextField fx:id="tfMeetingLink" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                   
                   <Label text="Mentor Feedback:" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP"/>
                   <TextArea fx:id="taMentorFeedback" prefColumnCount="20" prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                   
                   <Label text="Entrepreneur Feedback:" GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.valignment="TOP"/>
                   <TextArea fx:id="taEntrepreneurFeedback" prefColumnCount="20" prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                   <Label text="Mentor Rating:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                   <ComboBox fx:id="cbMentorRating" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                   
                   <Label text="Entrepreneur Rating:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                   <ComboBox fx:id="cbEntrepreneurRating" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
               </GridPane>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                   <Button text="Cancel" styleClass="button, button-secondary" fx:id="btnCancel"/>
                   <Button text="Save" styleClass="button" fx:id="btnSave"/>
               </HBox>
           </VBox>
        </VBox>
    </center>
</BorderPane>

