<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../najahni-master.css" xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.mentorat.ChatbotController">

    <top>
        <HBox styleClass="module-nav-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Retour" onAction="#handleGoBack" styleClass="module-back-btn"/>
            <Label text="Mentorat › Chatbot" styleClass="module-nav-title" HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Accueil" onAction="#handleGoHome" styleClass="module-home-btn"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Chatbot Assistant" />
            </HBox>

            <TextArea fx:id="chatArea" editable="false" prefHeight="400.0" prefWidth="600.0" styleClass="chat-area" wrapText="true" VBox.vgrow="ALWAYS" />

             <HBox alignment="CENTER_LEFT" spacing="10">
                 <TextField fx:id="inputField" prefWidth="500.0" promptText="Type your message here..." styleClass="chat-input" HBox.hgrow="ALWAYS" />
                 <Button fx:id="btnSend" styleClass="button" text="Send" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

