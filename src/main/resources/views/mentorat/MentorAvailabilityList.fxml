<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../najahni-master.css" xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.mentorat.MentorAvailabilityListController">

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Mentor Availability" />
                <HBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="153.0" HBox.hgrow="ALWAYS">
               <TextField fx:id="searchField" promptText="Search by name..." />
                    <Button fx:id="btnAdd" styleClass="button" text="+ New Availability" />
                </HBox>
            </HBox>

            <TableView fx:id="tableView" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                     <TableColumn prefWidth="50" text="ID"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Mentor"><cellValueFactory><PropertyValueFactory property="mentorName" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="100" text="Date"><cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="100" text="Start Time"><cellValueFactory><PropertyValueFactory property="startTime" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="100" text="End Time"><cellValueFactory><PropertyValueFactory property="endTime" /></cellValueFactory></TableColumn>
                     <TableColumn prefWidth="150" text="Created At"><cellValueFactory><PropertyValueFactory property="createdAt" /></cellValueFactory></TableColumn>
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

             <HBox alignment="CENTER_RIGHT" spacing="10">
                 <Button fx:id="btnDelete" styleClass="button-secondary" text="Delete" />
                 <Button fx:id="btnEdit" styleClass="button-secondary" text="Edit" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

