<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootStack"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.mentorat.MentoratAdminController"
           stylesheets="@../najahni-master.css"
           style="-fx-background-color: #f4f5f7;">

    <VBox spacing="0">

        <!-- HEADER BAR -->
        <VBox style="-fx-background-color: linear-gradient(to right, #e67e22, #d35400); -fx-padding: 16 28 12 28;"
              spacing="2">
            <Label text="Mentorat - Administration"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Gerer les demandes, sessions et disponibilites"
                   style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11;"/>
        </VBox>

        <!-- TAB BAR -->
        <HBox spacing="4" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 8 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">

            <Button fx:id="tabDashboard" text="Dashboard"
                    styleClass="mentorat-admin-tab" onAction="#showDashboard"/>
            <Button fx:id="tabRequests" text="Demandes"
                    styleClass="mentorat-admin-tab" onAction="#showRequests"/>
            <Button fx:id="tabSessions" text="Sessions"
                    styleClass="mentorat-admin-tab" onAction="#showSessions"/>
            <Button fx:id="tabAvailability" text="Disponibilites"
                    styleClass="mentorat-admin-tab" onAction="#showAvailability"/>
        </HBox>

        <!-- CONTENT AREA -->
        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #f4f5f7;">
            <padding><Insets top="0"/></padding>
        </StackPane>

    </VBox>

</StackPane>
