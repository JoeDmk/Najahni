<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="controllers.ChangeMdpController"
            stylesheets="@modern.css"
            style="-fx-background-color: #F0F2F5;"
            xmlns="http://javafx.com/javafx/17.0.14"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Réinitialiser le mot de passe" styleClass="page-header-title"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <VBox styleClass="glass-card" spacing="20" maxWidth="420" alignment="CENTER">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <Label text="🔑" style="-fx-font-size: 40px;"/>
                <Label text="Nouveau mot de passe" styleClass="page-title" style="-fx-font-size: 20px;"/>
                <Label text="Choisissez un mot de passe sécurisé" styleClass="page-subtitle"/>

                <VBox spacing="6">
                    <Label text="Nouveau mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="newPasswordField" styleClass="modern-field" prefHeight="44"
                                   promptText="Nouveau mot de passe"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Confirmer" styleClass="field-label"/>
                    <PasswordField fx:id="confirmPasswordField" styleClass="modern-field" prefHeight="44"
                                   promptText="Confirmer le mot de passe"/>
                </VBox>

                <Label fx:id="errorLabel" visible="false" wrapText="true" styleClass="error-label"/>
                <Label fx:id="successLabel" visible="false" wrapText="true" styleClass="success-label"/>

                <Button text="Réinitialiser" onAction="#handleReset"
                        styleClass="btn-primary-gradient" prefHeight="46" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
