<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MentorshipRequestListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="nav-bar">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="NAJAHNI" />
            <HBox alignment="CENTER_RIGHT" spacing="20" HBox.hgrow="ALWAYS">
                <Button styleClass="nav-button, active" text="Requests" />
                <Button fx:id="btnSessions" styleClass="nav-button" text="Sessions" />
                <Button fx:id="btnAvailability" styleClass="nav-button" text="Availability" />
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="header-label" text="Mentorship Requests" />
                <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                    <TextField fx:id="searchField" promptText="Search request..." />
                    <Button fx:id="btnAdd" styleClass="button" text="+ New Request" />
                </HBox>
            </HBox>
            
            <TableView fx:id="tableView" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="50" text="ID">
                        <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Entrepreneur">
                        <cellValueFactory><PropertyValueFactory property="entrepreneurName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Mentor">
                        <cellValueFactory><PropertyValueFactory property="mentorName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Project">
                         <cellValueFactory><PropertyValueFactory property="projectName" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="100" text="Date">
                        <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="80" text="Time">
                        <cellValueFactory><PropertyValueFactory property="time" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="100" text="Status">
                        <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="100" text="Match Score">
                         <cellValueFactory><PropertyValueFactory property="matchScore" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="80" text="Auto Approved">
                        <cellValueFactory><PropertyValueFactory property="autoApproved" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Motivation">
                        <cellValueFactory><PropertyValueFactory property="motivation" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Goals">
                        <cellValueFactory><PropertyValueFactory property="goals" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="150" text="Created At">
                        <cellValueFactory><PropertyValueFactory property="createdAt" /></cellValueFactory>
                    </TableColumn>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnDelete" styleClass="button-secondary" text="Delete" />
                <Button fx:id="btnEdit" styleClass="button-secondary" text="Edit" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
