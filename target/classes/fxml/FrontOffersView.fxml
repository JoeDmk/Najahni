<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.FrontOffersController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="front-scroll">
<content>
<VBox spacing="22" styleClass="front-page">
    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>

    <!-- ═══ HERO SECTION — Gradient banner ═══ -->
    <VBox alignment="CENTER" spacing="10" styleClass="fo-hero-banner">
        <Label text="💼 Mes Offres d'Investissement" styleClass="fo-hero-title"/>
        <Label text="Gérez vos offres, suivez leur statut et effectuez vos paiements en un clic."
               wrapText="true" maxWidth="550" styleClass="fo-hero-subtitle"
               style="-fx-text-alignment: center;"/>
    </VBox>

    <!-- ═══ STATS DASHBOARD — Enhanced visual cards ═══ -->
    <HBox spacing="16" alignment="CENTER">
        <!-- Total -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card" style="-fx-border-color: transparent transparent #2c3e50 transparent;">
            <Label text="📊" styleClass="risk-indicator-emoji"/>
            <Label fx:id="lblTotalOffers" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Total Offres" styleClass="fo-stat-label"/>
        </VBox>

        <!-- Pending -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-orange">
            <Label text="⏳" styleClass="risk-indicator-emoji"/>
            <Label fx:id="lblPendingOffers" text="0" styleClass="fo-stat-value, fo-stat-value-orange"/>
            <Label text="En Attente" styleClass="fo-stat-label"/>
        </VBox>

        <!-- Accepted -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-green">
            <Label text="✅" styleClass="risk-indicator-emoji"/>
            <Label fx:id="lblAcceptedOffers" text="0" styleClass="fo-stat-value, fo-stat-value-green"/>
            <Label text="Acceptées" styleClass="fo-stat-label"/>
        </VBox>

        <!-- Rejected -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              styleClass="fo-stat-card, fo-stat-card-red">
            <Label text="❌" styleClass="risk-indicator-emoji"/>
            <Label fx:id="lblRejectedOffers" text="0" styleClass="fo-stat-value, fo-stat-value-red"/>
            <Label text="Rejetées" styleClass="fo-stat-label"/>
        </VBox>
    </HBox>

    <!-- ═══ NEW OFFER FORM (collapsible) ═══ -->
    <TitledPane fx:id="newOfferPane" text="➕ Soumettre une nouvelle offre" expanded="false" 
                styleClass="front-titled-pane" animated="true">
        <VBox spacing="15" styleClass="front-form-inner">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Opportunité *" styleClass="form-label"/>
                    <ComboBox fx:id="cboOpportunity" promptText="Choisir une opportunité ouverte" 
                              maxWidth="Infinity" styleClass="front-combo"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Montant proposé (€) *" styleClass="form-label"/>
                    <TextField fx:id="txtAmount" promptText="Ex: 25000.00" styleClass="front-search-field"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="💰 Soumettre l'offre" onAction="#submitOffer" styleClass="front-btn-invest"/>
                <Button text="Annuler" onAction="#clearOfferForm" styleClass="front-btn-secondary"/>
                <Label fx:id="lblFormMsg" text="" styleClass="login-status"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- ═══ FILTER BAR ═══ -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="front-filter-bar">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <Label text="🔍" style="-fx-font-size: 16px;"/>
        <ComboBox fx:id="cboStatusFilter" promptText="Filtrer par statut" prefWidth="160" styleClass="front-combo"/>
        <Button text="Filtrer" onAction="#applyFilter" styleClass="front-btn-primary"/>
        <Button text="Effacer" onAction="#clearFilter" styleClass="front-btn-secondary"/>
    </HBox>

    <!-- ═══ OFFERS LIST (Cards) ═══ -->
    <FlowPane fx:id="offersContainer" hgap="18" vgap="18" alignment="CENTER"
              VBox.vgrow="ALWAYS" prefWrapLength="900"/>

    <!-- ═══ EMPTY STATE ═══ -->
    <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false"
          style="-fx-padding: 50;">
        <Label text="📭" styleClass="empty-state-icon"/>
        <Label text="Aucune offre trouvée" styleClass="empty-state-text"/>
        <Label text="Soumettez votre première offre en cliquant ci-dessus !" styleClass="empty-state-subtext"/>
    </VBox>

</VBox>
</content>
</ScrollPane>
