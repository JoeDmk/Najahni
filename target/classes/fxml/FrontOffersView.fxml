<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.FrontOffersController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="front-scroll"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="22" styleClass="front-page">
    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>

    <!-- ═══ HERO SECTION — Gradient banner ═══ -->
    <VBox alignment="CENTER" spacing="10"
          style="-fx-background-color: linear-gradient(to right, #0f3460, #16213e, #1a1a2e);
                 -fx-background-radius: 18; -fx-padding: 32 36;
                 -fx-effect: dropshadow(gaussian, rgba(15,52,96,0.45), 20, 0, 0, 8);">
        <Label text="💼 Mes Offres d'Investissement"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Gérez vos offres, suivez leur statut et effectuez vos paiements en un clic."
               wrapText="true" maxWidth="550"
               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.65); -fx-text-alignment: center;"/>
    </VBox>

    <!-- ═══ STATS DASHBOARD — Enhanced visual cards ═══ -->
    <HBox spacing="16" alignment="CENTER">
        <!-- Total -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #2c3e50 transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="📊" style="-fx-font-size: 22;"/>
            <Label fx:id="lblTotalOffers" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Total Offres"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Pending -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #f39c12 transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="⏳" style="-fx-font-size: 22;"/>
            <Label fx:id="lblPendingOffers" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
            <Label text="En Attente"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Accepted -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #27ae60 transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="✅" style="-fx-font-size: 22;"/>
            <Label fx:id="lblAcceptedOffers" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Acceptées"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Rejected -->
        <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-padding: 22 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-border-color: transparent transparent #e74c3c transparent; -fx-border-width: 0 0 3 0; -fx-border-radius: 14;">
            <Label text="❌" style="-fx-font-size: 22;"/>
            <Label fx:id="lblRejectedOffers" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            <Label text="Rejetées"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- ═══ NEW OFFER FORM (collapsible) ═══ -->
    <TitledPane fx:id="newOfferPane" text="➕ Soumettre une nouvelle offre" expanded="false" 
                styleClass="front-titled-pane" animated="true">
        <VBox spacing="15" styleClass="front-form-inner">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Opportunité *" styleClass="form-label"/>
                    <ComboBox fx:id="cboOpportunity" promptText="Choisir une opportunité ouverte" 
                              maxWidth="Infinity" styleClass="front-combo"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Montant proposé (€) *" styleClass="form-label"/>
                    <TextField fx:id="txtAmount" promptText="Ex: 25000.00" styleClass="front-search-field"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="💰 Soumettre l'offre" onAction="#submitOffer" styleClass="front-btn-invest"/>
                <Button text="Annuler" onAction="#clearOfferForm" styleClass="front-btn-secondary"/>
                <Label fx:id="lblFormMsg" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- ═══ FILTER BAR ═══ -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="front-filter-bar">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <Label text="🔍" style="-fx-font-size: 16px;"/>
        <ComboBox fx:id="cboStatusFilter" promptText="Filtrer par statut" prefWidth="160" styleClass="front-combo"/>
        <Button text="Filtrer" onAction="#applyFilter" styleClass="front-btn-primary"/>
        <Button text="Effacer" onAction="#clearFilter" styleClass="front-btn-secondary"/>
    </HBox>

    <!-- ═══ OFFERS LIST (Cards) ═══ -->
    <FlowPane fx:id="offersContainer" hgap="18" vgap="18" alignment="CENTER"
              VBox.vgrow="ALWAYS" prefWrapLength="900"/>

    <!-- ═══ EMPTY STATE ═══ -->
    <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false"
          style="-fx-padding: 50;">
        <Label text="📭" style="-fx-font-size: 48px;"/>
        <Label text="Aucune offre trouvée" style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
        <Label text="Soumettez votre première offre en cliquant ci-dessus !" style="-fx-font-size: 13px; -fx-text-fill: #95a5a6;"/>
    </VBox>

</VBox>
</content>
</ScrollPane>
