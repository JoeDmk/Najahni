<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.najahni.controllers.ApprentissageController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent;">
<content>
<VBox spacing="20" style="-fx-background-color: transparent;">
    
    <padding>
        <Insets top="10" right="15" bottom="10" left="10"/>
    </padding>
    
    <!-- En-tête de Page -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="🎓 Mon Apprentissage" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🏆 Vérifier Badges" onAction="#checkNewBadges" styleClass="btn-warning"/>
        <Button text="🔄 Actualiser" onAction="#refreshData" styleClass="btn-secondary"/>
    </HBox>
    
    <Separator/>
    
    <!-- Statistiques Utilisateur -->
    <VBox spacing="10">
        <Label text="📊 Mes Statistiques" styleClass="form-title"/>
        
        <HBox spacing="15">
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5" 
                  styleClass="gamification-stat-card, gamification-card-xp">
                <Label fx:id="lblTotalXP" text="0 XP" styleClass="gamification-stat-value"/>
                <Label text="⭐ Points XP Total" styleClass="gamification-stat-label"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                  styleClass="gamification-stat-card, gamification-card-courses">
                <Label fx:id="lblNiveau" text="Niveau 1" styleClass="gamification-stat-value"/>
                <Label text="📈 Niveau Actuel" styleClass="gamification-stat-label"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                  styleClass="gamification-stat-card" style="-fx-background-color: linear-gradient(to bottom right, #fc4a1a, #f7b733);">
                <Label fx:id="lblCoursCompletes" text="0" styleClass="gamification-stat-value"/>
                <Label text="✅ Cours Complétés" styleClass="gamification-stat-label"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                  styleClass="gamification-stat-card, gamification-card-level">
                <Label fx:id="lblBadges" text="0" styleClass="gamification-stat-value"/>
                <Label text="🏆 Badges Obtenus" styleClass="gamification-stat-label"/>
            </VBox>
        </HBox>
        
        <!-- Progression vers le prochain niveau -->
        <VBox spacing="5" styleClass="opportunity-form-section">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Progression vers le prochain niveau:" styleClass="form-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblProgressNiveau" text="0 XP restants" styleClass="empty-state-subtext"/>
            </HBox>
            <ProgressBar fx:id="progressNiveau" progress="0.0" prefHeight="20" maxWidth="Infinity"
                        style="-fx-accent: #667eea;"/>
        </VBox>
    </VBox>
    
    <!-- Contenu Principal -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Progression et Cours -->
        <VBox HBox.hgrow="ALWAYS" spacing="15">
            
            <!-- Ma Progression -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📚 Ma Progression" styleClass="form-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="cboEtatFilter" promptText="Filtrer par état" prefWidth="150"/>
                    <Button text="Filtrer" onAction="#filterProgressions" styleClass="btn-primary" style="-fx-margin-left: 10;"/>
                    <Button text="Effacer" onAction="#clearFilter" styleClass="btn-secondary"/>
                </HBox>
                
                <TableView fx:id="progressionTable" prefHeight="450" minHeight="350" VBox.vgrow="ALWAYS" 
                          style="-fx-min-width: 700;" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCours" text="Cours" prefWidth="280" minWidth="200"/>
                        <TableColumn fx:id="colPourcentage" text="Progression" prefWidth="200" minWidth="150"/>
                        <TableColumn fx:id="colXP" text="XP Gagné" prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="colNiveauCours" text="Niveau" prefWidth="90" minWidth="70"/>
                        <TableColumn fx:id="colEtat" text="État" prefWidth="140" minWidth="110"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="120" minWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune progression. Commencez un cours pour suivre votre avancement !"/>
                    </placeholder>
                </TableView>
            </VBox>
            
            <!-- Mes Badges -->
            <VBox spacing="10">
                <Label text="🏆 Mes Badges" styleClass="form-title"/>
                <FlowPane fx:id="badgesContainer" hgap="10" vgap="10" prefWrapLength="600"
                         styleClass="opportunity-form-section">
                    <Label text="Chargement des badges..." styleClass="empty-state-subtext"/>
                </FlowPane>
            </VBox>
            
        </VBox>
        
        <!-- Leaderboard -->
        <VBox fx:id="leaderboardContainer" spacing="10" minWidth="300" maxWidth="300">
            <Label text="🏅 Classement" styleClass="form-title"/>
            
            <VBox styleClass="opportunity-form-section">
                <TableView fx:id="leaderboardTable" prefHeight="350">
                    <columns>
                        <TableColumn fx:id="colRang" text="#" prefWidth="45" minWidth="40"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="120" minWidth="100"/>
                        <TableColumn fx:id="colLeaderXP" text="XP" prefWidth="60" minWidth="50"/>
                        <TableColumn fx:id="colLeaderNiveau" text="Niv." prefWidth="45" minWidth="40"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun classement"/>
                    </placeholder>
                </TableView>
                
                <Separator/>
                
                <VBox spacing="5" style="-fx-padding: 10 0 0 0;">
                    <Label text="💡 Conseils" styleClass="form-label"/>
                    <Label text="• Complétez des cours pour gagner des XP" wrapText="true" 
                           styleClass="empty-state-subtext"/>
                    <Label text="• Réussissez les quiz pour des bonus" wrapText="true"
                           styleClass="empty-state-subtext"/>
                    <Label text="• Débloquez des badges pour monter dans le classement" wrapText="true"
                           styleClass="empty-state-subtext"/>
                </VBox>
            </VBox>
        </VBox>
        
    </HBox>
    
</VBox>
</content>
</ScrollPane>
