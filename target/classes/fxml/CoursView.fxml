<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.najahni.controllers.CoursController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-padding: 0;">
<content>
<VBox spacing="15" style="-fx-background-color: transparent;">
    
    <padding>
        <Insets top="10" right="15" bottom="10" left="10"/>
    </padding>
    
    <!-- En-tête de Page -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="📚 Gestion des Cours" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nouveau Cours" onAction="#showAddForm" styleClass="btn-primary"/>
        <Button text="🔄 Actualiser" onAction="#refreshTable" styleClass="btn-secondary"/>
    </HBox>
    
    <Separator/>
    
    <!-- Cartes de Résumé -->
    <HBox spacing="15">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblTotalCours" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
            <Label text="Total Cours" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblCoursDebutant" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label text="Cours Débutant" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblCoursCertifiants" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
            <Label text="Certifiants" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
            <Label fx:id="lblTotalXP" text="0 XP" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
            <Label text="XP Disponible" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
        </VBox>
    </HBox>
    
    <!-- Contenu Principal - Vue Divisée -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" minHeight="450">
        
        <!-- Tableau des Cours -->
        <VBox HBox.hgrow="ALWAYS" spacing="10">
            <Label text="📋 Liste des Cours" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <!-- Barre de Recherche/Filtre -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtRecherche" promptText="🔍 Rechercher..." prefWidth="200"/>
                <ComboBox fx:id="cboNiveauFilter" promptText="Niveau" prefWidth="150"/>
                <ComboBox fx:id="cboTypeFilter" promptText="Type" prefWidth="150"/>
                <Button text="Filtrer" onAction="#filterCours" styleClass="btn-primary"/>
                <Button text="Effacer" onAction="#clearFilter" styleClass="btn-secondary"/>
            </HBox>
            
            <TableView fx:id="coursTable" VBox.vgrow="ALWAYS" minHeight="380">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="40"/>
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="200" minWidth="180"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colPointsXP" text="XP" prefWidth="80" minWidth="60"/>
                    <TableColumn fx:id="colCertification" text="Certifiant" prefWidth="80" minWidth="70"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="130" minWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Aucun cours trouvé. Créez votre premier cours !"/>
                </placeholder>
            </TableView>
        </VBox>
        
        <!-- Formulaire Cours -->
        <VBox fx:id="formContainer" styleClass="form-container" spacing="12" minWidth="350" maxWidth="350">
            <Label fx:id="formTitle" text="➕ Ajouter un Cours" styleClass="form-title"/>
            
            <Separator/>
            
            <!-- Champ ID Masqué -->
            <TextField fx:id="txtId" visible="false" managed="false"/>
            
            <!-- Titre -->
            <VBox spacing="5">
                <Label text="Titre *" styleClass="form-label"/>
                <TextField fx:id="txtTitre" promptText="Ex: Introduction à JavaFX" styleClass="form-field"/>
            </VBox>
            
            <!-- Description -->
            <VBox spacing="5">
                <Label text="Description" styleClass="form-label"/>
                <TextArea fx:id="txtDescription" promptText="Description détaillée du cours..." 
                          prefRowCount="3" wrapText="true" styleClass="form-field"/>
            </VBox>
            
            <!-- Type et Niveau -->
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Type *" styleClass="form-label"/>
                    <ComboBox fx:id="cboType" promptText="Type de cours" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Niveau *" styleClass="form-label"/>
                    <ComboBox fx:id="cboNiveau" promptText="Niveau" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>
            </HBox>
            
            <!-- Points XP et Durée -->
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Points XP" styleClass="form-label"/>
                    <TextField fx:id="txtPointsXP" promptText="100" styleClass="form-field"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Durée (min)" styleClass="form-label"/>
                    <TextField fx:id="txtDuree" promptText="30" styleClass="form-field"/>
                </VBox>
            </HBox>
            
            <!-- Certification -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkCertification" text="Cours certifiant 🏆"/>
            </HBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Boutons du Formulaire -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnSave" text="💾 Enregistrer" onAction="#saveCours" styleClass="btn-success"/>
                <Button fx:id="btnCancel" text="❌ Annuler" onAction="#cancelForm" styleClass="btn-secondary"/>
            </HBox>
            
            <Label fx:id="lblFormMessage" text="" styleClass="form-message"/>
        </VBox>
        
    </HBox>
    
</VBox>
</content>
</ScrollPane>
