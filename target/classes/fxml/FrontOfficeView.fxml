<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.najahni.controllers.FrontOfficeController"
            styleClass="fo-root">

    <!-- ═══ TOP NAVBAR ═══ -->
    <top>
        <HBox styleClass="fo-navbar" alignment="CENTER_LEFT" spacing="15">
            <padding>
                <Insets top="12" right="25" bottom="12" left="25"/>
            </padding>

            <Label text="🌐 NAJAHNI" styleClass="fo-navbar-brand"/>
            <Label fx:id="lblNavSubtitle" text="Espace Investisseur" styleClass="fo-navbar-subtitle"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnFoOpportunities" text="💰 Opportunités"
                    onAction="#showOpportunities"
                    styleClass="fo-nav-link, fo-nav-link-active"/>
            <Button fx:id="btnFoOffers" text="📨 Mes Offres"
                    onAction="#showOffers"
                    styleClass="fo-nav-link"/>
            <Button fx:id="btnFoPortfolio" text="💼 Portefeuille"
                    onAction="#showPortfolio"
                    styleClass="fo-nav-link"/>
            <Button fx:id="btnFoRiskAnalysis" text="🧠 Analyse IA"
                    onAction="#showRiskAnalysis"
                    styleClass="fo-nav-link"/>
            <Button fx:id="btnInbox" text="📬 Inbox" visible="false" managed="false"
                    onAction="#toggleInbox"
                    styleClass="fo-nav-link"/>

            <Region prefWidth="20"/>

            <Button text="⬅ Back Office" onAction="#goBackOffice"
                    styleClass="fo-btn-back"/>
            <Button text="🚪 Déconnexion" onAction="#handleLogout"
                    style="-fx-background-color: rgba(231,76,60,0.2); -fx-text-fill: #e74c3c; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 6 12;"/>
        </HBox>
    </top>

    <!-- ═══ CONTENT AREA ═══ -->
    <center>
        <StackPane fx:id="foContentArea" styleClass="fo-content">
            <!-- Views loaded dynamically here -->
        </StackPane>
    </center>

</BorderPane>
